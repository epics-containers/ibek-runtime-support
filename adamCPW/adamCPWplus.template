#
# Communicate with the device to query the gross weight and receive the response.
#
# We assume the device is in the mode where it has to be polled.
# The continuous mode will probably upset things.
# This actually issues the command called "Hold" to the balance.
# This is the name of one of the buttons on the balance and the manual
# states issuing the command is equivalent to pressing the button.
# The "Hold" button has multiple functions.
# This will only work if the balance is in the right mode to do the
# expected thing (return the weight) on response to the "Hold" command.
#
record(asyn, "$(P)$(R):GET:GROSSWEIGHT") {
  field(DESC, "Query Gross Weight")
  field(SCAN, "Passive")
  field(PORT, "$(port)")
  field(IEOS, "\r\n")
  field(OEOS, "\r\n")
  field(TMOT, "$(TMOT=3)" )
  field(AOUT, "G")
  field(FLNK, "$(P)$(R):CLC:GROSSWEIGHT")
}

