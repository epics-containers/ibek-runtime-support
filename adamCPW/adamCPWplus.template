# File adamCPWplus.template
#
# % macro , __doc__ , Support for the ADAM CPW plus 150 balance.  Typical application is to monitor contents of liquid cryogas dewars.
#
# Linda Pratt, 4th Jan 2016
#
# Since so few records involved, instructed to use asyn records in
# preference to streamDevice protocol.  The device has a command to
# tare the balance (zero it for doing net weights).  Have been
# instructed to provide minimal readback only.
# The unit does not really allow much in the way of control anyway.
#
# NOTE: IEOS and OEOS fields have been set to "\r\n" in this database, but there is a warning in the asynRecord documentation that this
# value is overridden by the initial setting of the port when the connection is made and therefore never used.  Therefore you
# have to initialise the port in some way yet to be determined.  Documentation says that if the field is written to after connection,
# then this is done.  Found during development that setting the field on the debug record miraculously made all the others parameters
# work, so this makes sense.
#
# % macro , P            , Mandatory.  Device prefix for PV names.
# % macro , R            , Mandatory.  Record name prefix.  PV names commence $P$R
# % macro , port         , Mandatory.  Serial port name.
# % macro , disable      , Optional.   To disable scanning if device is disconnected, 1 for disabled, 0 for enabled, defaults to zero.
# % macro , BALANCEDESC  , Optional.   Description of the balance.                              Defaults to Adam CPWplus balance.  (Populates DESCRIPTION     record VAL  field).  Example: End St1 LiqHe Balance1.
# % macro , GROSSDESC    , Optional.   Description of the weight read from the balance.         Defaults to Gross Weight.          (Populates GROSSWEIGHT RBV record DESC field).  Example: Current Dewar Weight.
# % macro , NETDESC      , Optional.   Description of the net weight read from the balance.     Defaults to Net Weight.            (Populates NETWEIGHT   RBV record DESC field).  Example: LiqHe Weight Used.
# % macro , TAREDESC     , Optional.   Description of the tare weight read from the balance.    Defaults to Tare Weight.           (Populates TAREWEIGHT  RBV record DESC field).  Example: Full Dewar Weight.
# % macro , OFFSETDESC   , Optional.   Description of the offset weight.                        Defaults to Offset Weight.         (Populates OFFSETWEIGHT    record DESC field).  Example: Empty Dewar Weight.
# % macro , OFFENTRYDESC , Optional.   Description for user to enter/set the offset weight.     Defaults to Enter Offset Weight.   (Populates OFFSETWEIGHT:ENTRYDESC record VAL field).  Example: Enter Empty Dewar Wt.
# % macro , MEASUREDDESC , Optional.   Description of the measured weight (calculated).         Defaults to Measured Weight.       (Populates MEASUREDWEIGHT  record DESC field).  Example: LiqHe Weight Remaining.
# % macro , GROSSLOLO    , Optional.   The low low alarm level value for the gross weight.      Defaults to empty.                 (Populates GROSSWEIGHT RBV record LOLO field).
# % macro , NETLOLO      , Optional.   The low low alarm level value for the net weight.        Defaults to empty.                 (Populates NETWEIGHT   RBV record LOLO field).
# % macro , MEASUREDLOLO , Optional.   The low low alarm level value for the measured weight.   Defaults to empty.                 (Populates MEASUREDWEIGHT  record LOLO field).
# % macro , GROSSLLSV    , Optional.   The low low alarm severity for the gross weight.         Defaults to NO_ALARM.              (Populates GROSSWEIGHT RBV record LLSV field).
# % macro , NETLLSV      , Optional.   The low low alarm severity for the net weight.           Defaults to NO_ALARM.              (Populates NETWEIGHT   RBV record LLSV field).
# % macro , MEASUREDLLSV , Optional.   The low low alarm severity for the measured weight.      Defaults to NO_ALARM.              (Populates MEASUREDWEIGHT  record LLSV field).
# % macro , GROSSLOW     , Optional.   The low alarm level value for the gross weight.          Defaults to empty.                 (Populates GROSSWEIGHT RBV record LOW  field).
# % macro , NETLOW       , Optional.   The low alarm level value for the net weight.            Defaults to empty.                 (Populates NETWEIGHT   RBV record LOW  field).
# % macro , MEASUREDLOW  , Optional.   The low alarm level value for the measured weight.       Defaults to empty.                 (Populates MEASUREDWEIGHT  record LOW  field).
# % macro , GROSSLSV     , Optional.   The low alarm severity for the gross weight.             Defaults to NO_ALARM.              (Populates GROSSWEIGHT RBV record LSV  field).
# % macro , NETLSV       , Optional.   The low alarm severity for the net weight.               Defaults to NO_ALARM.              (Populates NETWEIGHT   RBV record LSV  field).
# % macro , MEASUREDLSV  , Optional.   The low alarm severity for the measured weight.          Defaults to NO_ALARM.              (Populates MEASUREDWEIGHT  record LSV  field).
# % macro , GROSSHIGH    , Optional.   The high alarm level value for the gross weight.         Defaults to empty.                 (Populates GROSSWEIGHT RBV record HIGH field).
# % macro , NETHIGH      , Optional.   The high alarm level value for the net weight.           Defaults to empty.                 (Populates NETWEIGHT   RBV record HIGH field).
# % macro , MEASUREDHIGH , Optional.   The high alarm level value for the measured weight.      Defaults to empty.                 (Populates MEASUREDWEIGHT  record HIGH field).
# % macro , GROSSHSV     , Optional.   The high alarm severity for the gross weight.            Defaults to NO_ALARM.              (Populates GROSSWEIGHT RBV record HSV  field).
# % macro , NETHSV       , Optional.   The high alarm severity for the net weight.              Defaults to NO_ALARM.              (Populates NETWEIGHT   RBV record HSV  field).
# % macro , MEASUREDHSV  , Optional.   The high alarm severity for the measured weight.         Defaults to NO_ALARM.              (Populates MEASUREDWEIGHT  record HSV  field).
# % macro , GROSSHIHI    , Optional.   The high high alarm level value for the gross weight.    Defaults to empty.                 (Populates GROSSWEIGHT RBV record HIHI field).
# % macro , NETHIHI      , Optional.   The high high alarm level value for the net weight.      Defaults to empty.                 (Populates NETWEIGHT   RBV record HIHI field).
# % macro , MEASUREDHIHI , Optional.   The high high alarm level value for the measured weight. Defaults to empty.                 (Populates MEASUREDWEIGHT  record HIHI field).
# % macro , GROSSHHSV    , Optional.   The high high alarm severity for the gross weight.       Defaults to NO_ALARM.              (Populates GROSSWEIGHT RBV record HHSV field).
# % macro , NETHHSV      , Optional.   The high high alarm severity for the net weight.         Defaults to NO_ALARM.              (Populates NETWEIGHT   RBV record HHSV field).
# % macro , MEASUREDHHSV , Optional.   The high high alarm severity for the measured weight.    Defaults to NO_ALARM.              (Populates MEASUREDWEIGHT  record HHSV field).
# % macro , GROSSHYST    , Optional.   The alarm hysteresis for the gross weight.               Defaults to empty.                 (Populates GROSSWEIGHT RBV record HYST field).
# % macro , NETHYST      , Optional.   The alarm hysteresis for the net weight.                 Defaults to empty.                 (Populates NETWEIGHT   RBV record HYST field).
# % macro , MEASUREDHYST , Optional.   The alarm hysteresis for the measured weight.            Defaults to empty.                 (Populates MEASUREDWEIGHT  record HYST field).
# % macro , GROSSLOPR    , Optional.   The low operator value for the gross weight.             Defaults to empty.                 (Populates GROSSWEIGHT RBV record LOPR field).
# % macro , NETLOPR      , Optional.   The low operator value for the net weight.               Defaults to empty.                 (Populates NETWEIGHT   RBV record LOPR field).
# % macro , TARELOPR     , Optional.   The low operator value for the tare weight.              Defaults to empty.                 (Populates TAREWEIGHT  RBV record LOPR field).
# % macro , OFFSETLOPR   , Optional.   The low operator value for the offset weight.            Defaults to empty.                 (Populates OFFSETWEIGHT    record LOPR field).
# % macro , MEASUREDLOPR , Optional.   The low operator value for the measured weight.          Defaults to empty.                 (Populates MEASUREDWEIGHT  record LOPR field).
# % macro , GROSSHOPR    , Optional.   The high operator value for the gross weight.            Defaults to empty.                 (Populates GROSSWEIGHT RBV record HOPR field).
# % macro , NETHOPR      , Optional.   The high operator value for the net weight.              Defaults to empty.                 (Populates NETWEIGHT   RBV record HOPR field).
# % macro , TAREHOPR     , Optional.   The high operator value for the tare weight.             Defaults to empty.                 (Populates TAREWEIGHT  RBV record HOPR field).
# % macro , OFFSETHOPR   , Optional.   The high operator value for the offset weight.       	Defaults to empty.                 (Populates OFFSETWEIGHT    record HOPR field).
# % macro , MEASUREDHOPR , Optional.   The high operator value for the measured weight.         Defaults to empty.                 (Populates MEASUREDWEIGHT  record HOPR field).
# % macro , OFFSETDRVL   , Optional.   The low drive limit value for the offset weight.       	Defaults to empty.                 (Populates OFFSETWEIGHT    record DRVL field).
# % macro , OFFSETDRVH   , Optional.   The high drive limit value for the offset weight.       	Defaults to empty.                 (Populates OFFSETWEIGHT    record DRVH field).
# % macro , OFFSETDFLT   , Optional.   The default initial value for the offset weight.         Defaults to 0.                     (Populates OFFSETWEIGHT    record VAL field).
# % macro , PREC         , Optional.   The EPICS PREC precision fields.                         Defaults to 2. 
# % macro , EGU          , Optional.   The EPICS EGU engineering units fields.                  Defaults to kg.  No attempt is made to alter the settings on the device itself to match.
# % macro , ADEL         , Optional.   The EPICS ADEL archiver delta fields.                    Defaults to empty.
# % macro , TMOT         , Optional.   The EPICS TMOT timeout field on ASYN records.            Defaults to 3 (seconds).
# 
# An extra asyn record for debugging, which seems to be a favoured
# item for this style of implementation.
#
record(asyn, "$(P)$(R):DBG:ASYN") {
  field(DESC, "Spare ASYN for debug")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(IEOS, "\r\n")
  field(OEOS, "\r\n")
  field(TMOT, "$(TMOT=3)" )
  field(PORT, "$(port)")
}

#
# For diverting to when have difficulty parsing.
#
record(stringin, "$(P)$(R):DBG:RBV:TESTSTRING") {
  field(DESC, "String readback for debug")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(DTYP, "Soft Channel")
}

#
# The readback value of the gross weight.
#
# Negative values can occur (most likely with low load) due to 
# the zeroing functionality.
#
# This will be the weight of the dewar plus the liquid gas it contains
# in the typical application.
#
# % archiver 120 Monitor
# % autosave 1 HIHI LOLO HIGH LOW HHSV LLSV HSV LSV HOPR LOPR HYST ADEL
#
record(ai, "$(P)$(R):RBV:GROSSWEIGHT") {
  field(DESC, "$(GROSSDESC=Gross Weight)")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(DTYP, "Soft Channel")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(ADEL, "$(ADEL=)")
  field(LOLO, "$(GROSSLOLO=)")
  field(LLSV, "$(GROSSLLSV=NO_ALARM)")
  field(LOW, "$(GROSSLOW=)")
  field(LSV, "$(GROSSLSV=NO_ALARM)")
  field(HIGH, "$(GROSSHIGH=)")
  field(HSV, "$(GROSSHSV=NO_ALARM)")
  field(HIHI, "$(GROSSHIHI=)")
  field(HHSV, "$(GROSSHHSV=NO_ALARM)")
  field(HYST, "$(GROSSHYST=)")
  field(LOPR, "$(GROSSLOPR=)")
  field(HOPR, "$(GROSSHOPR=)")
  field(FLNK, "$(P)$(R):CLC:MEASUREDWEIGHT" )
}

#
# The readback value of the net weight.
#
# The net weight is calculated by the balance as Gross - Tare.
#
# Negative values are meaningful.
#
# The Tare/Zero button on the balance must have been pressed
# manually to make this meaningful.  For the typical application
# this will have been done when a full dewar of liquid gas was
# on the scale, so the negative value is the weight of liquid
# gas used.
#
# Note that when it comes to the alarm values,
# no attempt is made to main consistency between the
# net alarm values, the gross alarm values and the tare
# zero readback value.
#
# % archiver 120 Monitor
# % autosave 1 HIHI LOLO HIGH LOW HHSV LLSV HSV LSV HOPR LOPR HYST ADEL
#
record(ai, "$(P)$(R):RBV:NETWEIGHT") {
  field(DESC, "$(NETDESC=Net Weight)")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(DTYP, "Soft Channel")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(ADEL, "$(ADEL=)")
  field(LOLO, "$(NETLOLO=)")
  field(LLSV, "$(NETLLSV=NO_ALARM)")
  field(LOW, "$(NETLOW=)")
  field(LSV, "$(NETLSV=NO_ALARM)")
  field(HIGH, "$(NETHIGH=)")
  field(HSV, "$(NETHSV=NO_ALARM)")
  field(HIHI, "$(NETHIHI=)")
  field(HHSV, "$(NETHHSV=NO_ALARM)")
  field(HYST, "$(NETHYST=)")
  field(LOPR, "$(NETLOPR=)")
  field(HOPR, "$(NETHOPR=)")
}

#
# The readback value of the tare weight.
#
# The tare weight is the value of the gross weight
# when the Tare/Zero button was last pressed, provided
# the load was more than 10% of the range of the balance and
# it defines how the net weight is calculated (by the balance).
# In the typical application, this would be done when the balance
# is loaded with a full dewar of liquid gas.
#
# % archiver 120 Monitor
# % autosave 1 HOPR LOPR ADEL
#
record(ai, "$(P)$(R):RBV:TAREWEIGHT") {
  field(DESC, "$(TAREDESC=Tare Weight)")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(DTYP, "Soft Channel")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(ADEL, "$(ADEL=)")
  field(LOPR, "$(TARELOPR=)")
  field(HOPR, "$(TAREHOPR=)")
}

