#
# Parse the Gross string response for a numeric value.
# Yep, know it is already a string at present, but want to keep structure.
#
#record(scalcout, "$(P)$(R):DBG:CLC:TESTSTRING") {
#  field(DESC, "Parse test reply")
#  field(SCAN, "Passive")
#  field(PINI, "NO")
#  field(DTYP, "Soft Channel")
#  field(DOPT, "Use CALC")
#  field(CALC, "SSCANF(AA, '%s')")
#  field(INAA, "$(P)$(R):DBG:GET:TESTSTRING.AINP")
#  field(OUT, "$(P)$(R):DBG:RBV:TESTSTRING MS PP")
#}

#
# Parse the Gross string response for a numeric value.
#
# There is a reason for a diabolical parsing formula to read one
# simple number.  The device always gives a sign character before the
# number, but the number is padded with zero to two leading spaces
# after the sign and a straight forward %f scan cannot cope with these
# possibilities, EPICS sscanf can only have one number or string
# converted in each call and attempting to search for the spaces to
# remove could will hit on the trailing space in the zero leading
# space case.  The combination of conversions gives a single formula,
# and so avoids the needs for further calc records.  Another way to do
# it might be to use conditional test involving the sign character,
# but whatever you do to cover all cases you have to scan the sign and
# the number separately and recombine.
#
# (1) First scan the sign character.
# (2) Then scan the input again, skipping the first (sign) character and scanning as a real number.
#     The %f formula will eat any leading spaces and stop on the trailing space (which comes before the units).
#     The max width of 6 is present for best practice to stop a runaway scan in case of the trailing space being absent.
# (3) Do a formatted print of the number from (2).  Now have a string consisting of the number without leading sign or space.
# (4) Concatenate the scanned sign from step (1) with the converted number string from step (3).
# (5) Scan the resulting string from step (4) again - it is a number with a leading sign character with no spaces before or after, so nothing to upset the format converter.
#
record(scalcout, "$(P)$(R):CLC:GROSSWEIGHT") {
  field(DESC, "Parse Gross Weight reply")
  field(SCAN, "Passive")
  field(PINI, "NO")
  field(DTYP, "Soft Channel")
  field(DOPT, "Use CALC")
#              (5)    (1)        (1) (4)(3)     (3)    (2)        (2)           (5)                
  field(CALC, "SSCANF(SSCANF(AA,'%1s')+(PRINTF('%.2f',(SSCANF(AA,'%*1s%6f')))),'%f')")
#  field(CALC, "SSCANF(AA, '%f')")
  field(INAA, "$(P)$(R):GET:GROSSWEIGHT.AINP")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(OUT, "$(P)$(R):RBV:GROSSWEIGHT MS PP")
}

