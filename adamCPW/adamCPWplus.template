#
# This record controls regular scanning of the command to readback the weights.
# The DISABLE record stops it processing altogether.
#
record(ao, "$(P)$(R):SCN:WEIGHTSFAST") {
  field(DESC, "Scan weight queries")
  field(SCAN, "10 second")
  field(VAL, "1")
  field(SDIS, "$(P)$(R):DISABLE")
  field(FLNK, "$(P)$(R):SEQ:ALLWEIGHTS")
}

#
# Propagate scan processing to all the weight queries.
#
record(seq, "$(P)$(R):SEQ:ALLWEIGHTS") {
  field(DESC, "Propagate weight queries")
  field(DOL1, "1")
  field(DOL2, "1")
  field(DOL3, "1")
  field(DLY1, "0")
  field(DLY2, "3")
  field(DLY3, "6")
  field(LNK1, "$(P)$(R):GET:GROSSWEIGHT.PROC")
  field(LNK2, "$(P)$(R):GET:NETWEIGHT.PROC")
  field(LNK3, "$(P)$(R):GET:TAREWEIGHT.PROC")
  field(SELM, "All")
}

#
# This record needed to stop various records scanning and generating lots
# of error messages if the box is unplugged - this tends to be needed
# for end station IOCs.
#
# % autosave 1 VAL
#
record(bo, "$(P)$(R):DISABLE") {
  field(DESC, "Disable comms/processing")
  field(PINI, "YES")
  field(VAL, "$(disable=0)")
  field(OMSL, "supervisory")
  field(ZNAM, "Enabled")
  field(ONAM, "Disabled")
}


#
# The offset weight.
#
# To be set by the user for use in the calculation of the measured weight.
# This will be the dewar weight in the typical application.
# Record has been given prefix CFG for configuration.  It has HOPR and LOPR
# macros for display, but it does not make sense to apply alarms to
# this quantity.  This one has features special to it because it is an output
# The VAL field is autosaved because it does not get updated other than by
# the user so it wont get refreshed on reboot, so this allows it to persist.
# OFFSETDFLT - allows a predetermined default value other than zero to be defined.
# OFFSETDRVH - allows definition of restriction to be applied to what can be entered.
# OFFSETDRVL - ditto
#
# % autosave 1 VAL HOPR LOPR DRVH DRVL ADEL
#
record(ao, "$(P)$(R):CFG:OFFSETWEIGHT") {
  field(DESC, "$(OFFSETDESC=Offset Weight)")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(ADEL, "$(ADEL=)")
  field(LOPR, "$(OFFSETLOPR=)")
  field(HOPR, "$(OFFSETHOPR=)")
  field(DRVL, "$(OFFSETDRVL=)")
  field(DRVH, "$(OFFSETDRVH=)")
  field(VAL, "$(OFFSETDFLT=0)")
  field(FLNK, "$(P)$(R):CLC:MEASUREDWEIGHT" )
}

#
# The measured weight.
#
# The result of the calculation by EPICS = Gross - Offset.
# The liquid gas weight remaining in the dewar in the typical application.
#
# % archiver 120 Monitor
# % autosave 1 HIHI LOLO HIGH LOW HHSV LLSV HSV LSV HOPR LOPR HYST ADEL
#
record(ai, "$(P)$(R):STS:MEASUREDWEIGHT") {
  field(DESC, "$(MEASUREDDESC=Measured Weight)")
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(PREC, "$(PREC=2)")
  field(EGU, "$(EGU=kg)")
  field(ADEL, "$(ADEL=)")
  field(LOLO, "$(MEASUREDLOLO=)")
  field(LLSV, "$(MEASUREDLLSV=NO_ALARM)")
  field(LOW, "$(MEASUREDLOW=)")
  field(LSV, "$(MEASUREDLSV=NO_ALARM)")
  field(HIGH, "$(MEASUREDHIGH=)")
  field(HSV, "$(MEASUREDHSV=NO_ALARM)")
  field(HIHI, "$(MEASUREDHIHI=)")
  field(HHSV, "$(MEASUREDHHSV=NO_ALARM)")
  field(HYST, "$(MEASUREDHYST=)")
  field(LOPR, "$(MEASUREDLOPR=)")
  field(HOPR, "$(MEASUREDHOPR=)")
}

#
# Calculates the measured weight.
#
# This is calculated by EPICS as the difference between the 
# gross weight read back from the balance and the offset weight
# entered by the user.
#
record(calcout, "$(P)$(R):CLC:MEASUREDWEIGHT") {
  field(INPA, "$(P)$(R):RBV:GROSSWEIGHT NPP MS")
  field(INPB, "$(P)$(R):CFG:OFFSETWEIGHT NPP MS")
  field(CALC, "A-B")
  field(OUT, "$(P)$(R):STS:MEASUREDWEIGHT PP MS")
}

# The description of the device, used for screen labels.
#
record(stringin, "$(P)$(R):DESCRIPTION") {
  field(DESC, "Description of the balance.")
  field(VAL, "$(BALANCEDESC=Adam CPWplus balance)")
  field(SCAN, "Passive")
  field(PINI, "YES")
}

#
# Description of configuring offset weight.
#
# Need an screen label next to where the user enters the offset value
# describing what setting the offset weight does whereas the DESC field on 
# the offset weight describes the offset weight itself, so implemented
# a separate string record.  Recommend keep it brief.
#
record(stringin, "$(P)$(R):CFG:OFFSETWEIGHT:ENTRYDESC") {
  field(DESC, "Describes offset weight entry.")
  field(VAL, "$(OFFENTRYDESC=Enter Offset Weight)")
  field(SCAN, "Passive")
  field(PINI, "YES")
}
