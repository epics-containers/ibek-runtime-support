#% macro, dom, Beamline domain

### calculate flux ###

#% autosave 1 A B C D E CALC
record(calc, "$(dom)-MO-FSWT-01:FLUX:SLOPE")
{
  field(A, "0.000118") 
  field(B, "-0.006587")
  field(C, "0.140603")
  field(D, "-1.436759")
  field(E, "-11.370252")
  field(INPF, "$(dom)-MO-DCM-01:ENERGY.RBV CP")
  field(PREC, "15")
  field(CALC, "10^((A*F**4)+(B*F**3)+(C*F**2)+(D*F)+E)")
}

#% autosave 1 CALC
record(calc, "$(dom)-MO-FSWT-01:FLUX")
{
  field(INPA, "$(dom)-MO-FSWT-01:FLUX:SLOPE CP")
  field(INPB, "$(dom)-EA-XBPM-02:SumAll:MeanValue_RBV CP")
  field(CALC, "B>6*10^-9?B/A:0")
}

record(calc, "$(dom)-MO-FLUX-01:SAMP")
{
    field(CALC, "A*B*C")
    field(DESC, "curr flux with scaty&mapt")
    field(INPA, "$(dom)-MO-SCAT-01:Y:CURR_FACTOR CP")
    field(INPB, "$(dom)-MO-FSWT-01:FLUX CP")
    field(INPC, "$(dom)-MO-MAPT-01:Y:CURR_FACTOR CP")
}

record(calc, "$(dom)-MO-FLUX-01:PRED")
{
    field(CALC, "A*B*C")
    field(DESC, "predicted flux with scaty&mapt")
    field(INPA, "$(dom)-MO-SCAT-01:Y:REQ_FACTOR CP")
    field(INPB, "$(dom)-MO-FSWT-01:FLUX CP")
    field(INPC, "$(dom)-MO-MAPT-01:Y:REQ_FACTOR CP")
}

record(calc, "$(dom)-MO-MAPT-01:Y:CURR_FACTOR")
{
    field(CALC, "A*E + B*F+C*G+D*H")
    field(DESC, "mapty current factor")
    field(INPA, "$(dom)-MO-MAPT-01:Y:SMALL_FACTOR CP")
    field(INPB, "$(dom)-MO-MAPT-01:Y:MEDIUM_FACTOR CP")
    field(INPC, "$(dom)-MO-MAPT-01:Y:LARGE_FACTOR CP")
    field(INPD, "$(dom)-MO-MAPT-01:Y:OTHER_FACTOR CP")
    field(INPE, "$(dom)-MO-MAPT-01:Y:SMALL_CALC CP")
    field(INPF, "$(dom)-MO-MAPT-01:Y:MEDIUM_CALC CP")
    field(INPG, "$(dom)-MO-MAPT-01:Y:LARGE_CALC CP")
    field(INPH, "$(dom)-MO-MAPT-01:Y:OTHER_CALC CP")
    field(PINI, "YES")
}

