###########################################################
#
# Template to turn on/off both ARM air bearings at the same time.
#
# There is no interlock wait for the outboard motor.
#
# Martin Gaughran   11 Apr 2018
#
# 2024/06 - PLC controller logic changed to master/slave configuration
#       (i.e. one valve controller is in charge to turn on/off the other one)
#
###########################################################

# Macros:
# % macro, P, EPICS name prefix
# % macro, R, EPICS name suffix
# % macro, AirValveMasterCtrl, Record for master valve controller (Granite air ctrl)
# % macro, AirValveSlaveCtrl, Record for slave valve controller (Marble air ctrl)
# % macro, MOTORSTATUS, PV for the motor status bits.
# % macro, name, Object and gui association name

# This associates a BOY screen with the template
# % gui, $(name=), boyembed, BL21ISupportApp_opi/bo_embed_box.opi, DESC=ARM Air Bearing Control, device=$(P)$(R)
# % gui, $(name=), boyembed, BL21ISupportApp_opi/bo_embed.opi, DESC=ARM Air Bearing Control, device=$(P)$(R)

record(sseq, "$(P)$(R):OPEN") {
  field(SCAN, "Passive")
  field(STR1, "Reset")
  field(LNK1, "$(AirValveMasterCtrl):CON CA")
  field(WAIT1, "Wait")
  field(STR2, "Open")
  field(LNK2, "$(AirValveMasterCtrl):CON CA")
  field(WAIT2, "Wait")
  field(DLY3, "5")
  field(STR3, "Dummy")
  field(LNK3, "$(P)$(R):DUMMY")
  field(WAIT3, "Wait")
}

record(sseq, "$(P)$(R):CLOSE") {
  field(SCAN, "Passive")
  field(DLY1, "3")
  field(STR1, "Close")
  field(LNK1, "$(AirValveMasterCtrl):CON CA")
  field(WAIT1, "Wait")
  field(DLY2, "3")
  field(STR2, "Dummy")
  field(LNK2, "$(P)$(R):DUMMY")
  field(WAIT2, "Wait")
}

# Dummy record to allow delay to take effect
record(stringin, "$(P)$(R):DUMMY") {
}

record(mbbo, "$(P)$(R)") {
  field(SCAN, "Passive")
  field(DTYP, "Raw Soft Channel")
  field(OMSL, "supervisory")
  field(ZRST, "Air Off")
  field(ZRVL, "1")
  field(ONST, "Air On")
  field(ONVL, "2")
  field(OUT, "$(P)$(R):SELECT.SELN PP")
}

record(fanout, "$(P)$(R):SELECT") {
  field(SCAN, "Passive")
  field(LNK1, "$(P)$(R):CLOSE")
  field(LNK2, "$(P)$(R):OPEN")
  field(SELM, "Specified")
}

# Indicates current status of the valves
record(calcout, "$(P)$(R):VALVE:STATUS:CALC") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(OUT, "$(P)$(R):VALVE:STATUS PP")
  field(INPA, "$(AirValveMasterCtrl):STA CP")
  field(INPB, "$(AirValveSlaveCtrl):STA CP")
  field(CALC, "(A!=1)+(2*(B!=1))")
  field(OOPT, "On Change")
  field(DOPT, "Use CALC")
}

record(mbbi, "$(P)$(R):VALVE:STATUS") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZRST, "Both Valves Open")
  field(ONST, "Granite Valve Closed")
  field(TWST, "Marble Valve Closed")
  field(THST, "Both Valves Closed")
}

# Indicates when the motor can move, by considering the
# 'problem' status bit on the motor axis.
record(calcout, "$(P)$(R):MOTION:STATUS:CALC") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(INPA, "$(MOTORSTATUS) CP")
  field(CALC, "((A&512)#512)")
  field(OOPT, "On Change")
  field(DOPT, "Use CALC")
  field(OUT, "$(P)$(R):MOTION:STATUS PP")
}

record(bi, "$(P)$(R):MOTION:STATUS") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZNAM, "Motion ILKs Tripped")
  field(ONAM, "Motion ILKs Clear")
}
