###########################################################
#
# Template to turn on/off SGM air bearing.
#
# There is no interlock wait for the outboard motor.
#
# Martin Gaughran   11 Apr 2018
#
###########################################################

# Macros:
# % macro, P, EPICS name prefix
# % macro, R, EPICS name suffix
# % macro, SGMTravellerAirValve, Record for SGM Traveller Air control
# % macro, MOTORSTATUS, PV for the motor status bits.
# % macro, name, Object and gui association name

# This associates a BOY screen with the template
# % gui, $(name=), boyembed, BL21ISupportApp_opi/bo_embed_box.opi, DESC=SGM Traveller Air Bearing control, device=$(P)$(R)
# % gui, $(name=), boyembed, BL21ISupportApp_opi/bo_embed.opi, DESC=SGM Traveller Air Bearing control, device=$(P)$(R)

record(sseq, "$(P)$(R):OPEN") {
  field(SCAN, "Passive")
  field(STR1, "Reset")
  field(LNK1, "$(SGMTravellerAirValve):CON CA")
  field(WAIT1, "Wait")
  field(STR2, "Open")
  field(LNK2, "$(SGMTravellerAirValve):CON CA")
  field(WAIT2, "Wait")
}

record(sseq, "$(P)$(R):CLOSE") {
  field(SCAN, "Passive")
  field(STR1, "Close")
  field(LNK1, "$(SGMTravellerAirValve):CON CA")
  field(WAIT1, "Wait")
}

record(mbbo, "$(P)$(R)") {
  field(SCAN, "Passive")
  field(DTYP, "Raw Soft Channel")
  field(OMSL, "supervisory")
  field(ZRST, "Air Off")
  field(ZRVL, "1")
  field(ONST, "Air On")
  field(ONVL, "2")
  field(OUT, "$(P)$(R):SELECT.SELN PP")
}

record(fanout, "$(P)$(R):SELECT") {
  field(SCAN, "Passive")
  field(LNK1, "$(P)$(R):CLOSE")
  field(LNK2, "$(P)$(R):OPEN")
  field(SELM, "Specified")
}

# Indicates current status of the valve
record(calcout, "$(P)$(R):VALVE:STATUS:CALC") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(OUT, "$(P)$(R):VALVE:STATUS PP")
  field(INPA, "$(SGMTravellerAirValve):STA CP")
  field(CALC, "(A!=1)")
  field(OOPT, "On Change")
  field(DOPT, "Use CALC")
}

record(mbbi, "$(P)$(R):VALVE:STATUS") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZRST, "Valve Open")
  field(ONST, "Valve Closed/Fault/Other")
}

# Indicates when the motor can move, by considering the
# 'problem' status bit on the motor axis.
record(calcout, "$(P)$(R):MOTION:STATUS:CALC") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(INPA, "$(MOTORSTATUS) CP")
  field(CALC, "((A&512)#512)")
  field(OOPT, "On Change")
  field(DOPT, "Use CALC")
  field(OUT, "$(P)$(R):MOTION:STATUS PP")
}

record(bi, "$(P)$(R):MOTION:STATUS") {
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZNAM, "Motion ILKs Tripped")
  field(ONAM, "Motion ILKs Clear")
}
