###########################################################
#
# Template to trigger M5 smarpod stops when any of the
# limits is trigerred (by changing to Off)
#
# Macros:
#% macro, P, EPICS name prefix
#% macro, R, EPICS name suffix
#% macro, LIMIT_PREFIX, The prefix used for the smarpod limits
#% macro, LIMIT1, Limit A suffix
#% macro, LIMIT2, Limit B suffix
#% macro, LIMIT3, Limit C suffix
#% macro, LIMIT4, Limit D suffix
#% macro, LIMIT5, Limit E suffix
#% macro, LIMIT6, Limit F suffix
#% macro, LIMIT7, Limit G suffix
#% macro, STOPLINK1, The record used to stop smarpod one
#% macro, STOPLINK2, The record used to stop smarpod two
#
# Martin Gaughran   16 Feb 2017
#
###########################################################

# Scan OUT (passive) PV when the sum of all limits has decreased
record(calcout, "$(P)$(R):CALC2") {
  field(SCAN, "Passive")
  field(INPA, "$(P)$(R):AI1.VAL")
  field(INPB, "$(P)$(R):AI1.VAL PP")
  field(OUT, "$(P)$(R):FO1.VAL PP")
  field(OOPT, "When Non-zero")
  field(CALC, "(B<A)")
}

# Calculated the sum of all limits
record(calc, "$(P)$(R):CALC1") {
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(FLNK, "$(P)$(R):CALC2")
  field(INPA, "$(LIMIT_PREFIX)$(LIMIT1) CP")
  field(INPB, "$(LIMIT_PREFIX)$(LIMIT2) CP")
  field(INPC, "$(LIMIT_PREFIX)$(LIMIT3) CP")
  field(INPD, "$(LIMIT_PREFIX)$(LIMIT4) CP")
  field(INPE, "$(LIMIT_PREFIX)$(LIMIT5) CP")
  field(INPF, "$(LIMIT_PREFIX)$(LIMIT6) CP")
  field(INPG, "$(LIMIT_PREFIX)$(LIMIT7) CP")
  field(CALC, "A+B+C+D+E+F+G")
}

# Store the previous sum of all limits
record(ai, "$(P)$(R):AI1") {
  field(SCAN, "Passive")
  field(INP, "$(P)$(R):CALC1.VAL")
}

# Trigger the stop commands for both smarpods
record(fanout, "$(P)$(R):FO1") {
  field(SCAN, "Passive")
  field(LNK1, "$(STOPLINK1)")
  field(LNK2, "$(STOPLINK2)")
}
