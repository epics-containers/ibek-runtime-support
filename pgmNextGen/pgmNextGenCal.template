#
# The currently selected value of the pitch motor offset implied from 
# the current mirror in operation (which in turn are implied from current 
# grating selection via records in the input links) is written to the
# pitch motor record.
#
# Provision of the PITCHCAL macro is a bit of defensive programming in
# case ever want to use the adjustment offset parameters provided in
# the co-ordinate system (i.e. a small fudge factor on a standard
# offset like BL06I does with its OMS system) instead of the motor
# record offsets directly as has been specified for BL05I.  The motor
# offsets have the advantage they will work for a beamline using the
# EPICS soft motors instead of the co-ordinate system implementation.
#
# So by judicious changes to the PITCHMOTOR, PITCHCAL and the
# calibration table macro definitions in the IOC build could do that
# here with no programming changes to this template (but the variables
# for them need to get implemented in the main database, which I think
# they are not at present).
#
record (sel, "$(P)$(R):M_CAL")
{
 field (DESC, "$(PITCHDESC=Pitch) calib selected.")
 field (SELM, "Specified")
 field (INPA, "$(P)$(R):M1_CAL")
 field (INPB, "$(P)$(R):M2_CAL")
 field (INPC, "$(P)$(R):M3_CAL")
 field (INPD, "$(P)$(R):M4_CAL")
 field (INPE, "$(P)$(R):M5_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (FLNK, "$(P)$(R):SET:PITCHCAL")
}

#
# The sel record does not have an OUT field to write its value onwards,
# therefore need something to do that for us.
# We could convert the whole thing to a calcout or a transform but prefer
# to avoid mysterious calculations by using base records.
#
record (ao, "$(P)$(R):SET:PITCHCAL")
{
 field (DESC, "Apply $(PITCHDESC=Pitch) calibn.")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (OIF, "Full")
 field (DOL, "$(P)$(R):M_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (OUT, "$(P)$(PITCHMOTOR)$(PITCHCAL=.OFF)")
}

# *******************************************************
# * END OF RECORDS FOR CALIBRATION CELL SELECTION 
# *******************************************************
#
# *******************************************************
# * START OF EDITING SUPPORT RECORDS
# *******************************************************
# * 
# * The user needs to be able to set the calibration entries,
# * so need extra records to support visibility changes on the GUI
# * screens.
# * 
# * Also the original processing chain was designed and tested
# * to ensure changes were propagated when the grating and mirror
# * were selected via their multipositioners which move the 
# * translation motors.  To extend to support editing need to monitor 
# * when user finishes and retrigger some processing.  
# * 
# *******************************************************
#
# % autosave 1 VAL
#
# Are there changes pending? 
#
# We need a widget to remind the user they must click Done on the
# calibration screen to apply the changes, this record supports that.
#
# This is a bituvva cheat because:
# (a) The processing to propagate any changes and clear this pending PV
#     will be done when the user clicks Done on the calibration screen
#     in any case, i.e. it ignores this PV.
# (b) We assume that if the user clicks the column edit button on the
#     calibration table screen then there are changes pending whether
#     or not the user has changed anything.
# (c) Apparent madness, we also set this when the user clicks the Done
#     button on the column edit screen, but there is method.  This is
#     a defensive measure because the EDM screens do not block, so if
#     the user does things in a slightly different order to that
#     anticipated it is possible to get in a muddle otherwise.  A
#     determined effort to subvert the editing system could still
#     produce confusing behaviour, but at least have attempted to be
#     robust.
# 
record(bo, "$(P)$(R):EDIT:PENDING")
{
  field(DESC, "Edits of $(PITCHDESC=Pitch) Pending")
  field(ZNAM, "None")
  field(ONAM, "Pending")
  field(VAL, "0")
  field(PINI, "YES")
}

#
# Clear the changes pending record (set it to zero).
#
record (bo, "$(P)$(R):EDIT:PENDINGCLEAR")
{
 field (DESC, "Clear changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "0")
 field (OUT, "$(P)$(R):EDIT:PENDING PP")
}

#
# Set the changes pending PV (set it to one).
#
record (bo, "$(P)$(R):EDIT:PENDINGSET")
{
 field (DESC, "Set changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "1")
 field (OUT, "$(P)$(R):EDIT:PENDING PP")
}

#
# % autosave 1 VAL
#
# Edit Mode record supports entering Edit mode on the calibration table screen.
# The GUI writes to set the value of this record and it has extra widgets which appear
# dependent on this record.  Onward processing actions the change of mode in the database.
#
# Initialise to not in Edit mode.
# 0 for Done Editing i.e. not in Edit Mode.
# 1 for Edit         i.e. in Edit Mode.
# 
record(bo, "$(P)$(R):EDIT:MODE")
{
  field(DESC, "Control Editing of $(PITCHDESC=Pitch)")
  field(ZNAM, "Done")
  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P)$(R):EDIT:MODECALC PP")
}

#
# Calculate an action code on change of the EDIT mode state.
# The MODE is a binary, but the MODEACTIONFAN action selection fanout needs link numbers starting from 1.
#
record(calcout, "$(P)$(R):EDIT:MODECALC") 
{
  field(DESC, "React to edit mode change")
  field(INPA, "$(P)$(R):EDIT:MODE NPP")
  field(OOPT, "On Change")
  field(CALC, "A+1")
  field(PINI, "NO")
  field(OUT, "$(P)$(R):EDIT:MODEACTION PP" )
}

#
# To hold the calculated action code.
# 1 for Done,
# 2 for Edit.
#
# This record was clearly originally intended to be a bo not an ao,
# but it has been ao since first prod version of the template and I dont
# have time to test changing it to bo.  The ZNAM and ONAM fields were not
# before, but are now causing errors in the bootlog (EPICS base update??) 
# when the database is loaded as the ao record does not have these fields.
# Clearly it works as an ao, so am commenting out the problem fields for 
# now to shut up the errors.
#
record(ao, "$(P)$(R):EDIT:MODEACTION")
{
  field(DESC, "Control Editing of $(PITCHDESC=Pitch)")
#  field(ZNAM, "Done")
#  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P)$(R):EDIT:MODEACTIONFAN PP")
}

#
# Select which action to do (enter or leave edit mode).
# Uses the link selection functionality of the fanout record.
# 1 for Done
# 2 for Edit
#
record(fanout, "$(P)$(R):EDIT:MODEACTIONFAN")
{
  field(DESC, "Select mode action.")
  field(SCAN, "Passive")
  field(SELM, "Specified")
  field(SELL, "$(P)$(R):EDIT:MODEACTION")
  field(LNK1, "$(P)$(R):EDIT:MODEACTIONDONE")
  field(LNK2, "$(P)$(R):EDIT:MODEACTIONEDIT")
}

#
# The Done Action for the calibration table screen.
# LNK1 Update timestamp of last edit.
# LNK2 Sends out command to synchronise all the internal calibration
#      tables and the pitch motor calibration.  This might cause the
#      pitch motor position to jump, but NOT to move and neither
#      should the translation motors.
# LNK3 Clears the changes pending record to remove the message from
#      the calibration table screen.
#
record(seq, "$(P)$(R):EDIT:MODEACTIONDONE")
{
  field(DESC, "Finish editing $(PITCHDESC=Pitch)")
  field(DOL1, "1")
  field(LNK1, "$(P)$(R):EDIT:TIMECALC.PROC PP")
  field(DOL2, "1")
  field(LNK2, "$(P)$(R):EDIT:SYNCSEQ.PROC PP")
  field(DLY3, "5")
  field(DOL3, "1")
  field(LNK3, "$(P)$(R):EDIT:PENDINGCLEAR.PROC PP")
}

#
# The Edit Action for the calibration table screen.
#
record(fanout, "$(P)$(R):EDIT:MODEACTIONEDIT")
{
  field(DESC, "Start editing $(PITCHDESC=Pitch)")
}

#
# We dont currently need this because 
# (a) We do not toggle control to edit on the column edit screen
# (b) We ignore the PENDING record in calculations
# (c) We provide no extra records for the desired values, instead 
#     the column edit screen writes directly into the existing positioner records.
# The GUI screens write directly to the ACTION records instead.
#
