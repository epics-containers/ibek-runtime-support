#
# The Done Action for the calibration Calibration Column Edit screen.
# We assume changes are pending whether or not the user actually changed any numbers.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P)$(R):EDIT:COLACTIONDONE")
{
  field(DESC, "Finish a Mirror Column edit")
  field(LNK1, "$(P)$(R):EDIT:PENDINGSET PP")
}

#
# The Edit Action on starting the calibration Mirror Column Edit screen by pressing
# one of the Edit buttons on the calibration table screen.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P)$(R):EDIT:COLACTIONEDIT")
{
  field(DESC, "Start Mirror Column edit")
  field(LNK1, "$(P)$(R):EDIT:PENDINGSET PP")
}

#
# To get a timestamp string. Needed to store when the last edit was done.
# This will probably only be true if the user has used the GUI to do the editing.
# If scripted caputs to the positioner values have been used, this will have been bypassed.
# This documentation on the Soft Timestamp DTYP is hard to find, followed an example
# from Tech Talk archives.
#
record(stringin, "$(P)$(R):EDIT:TIMENOWGET") 
{
  field(DESC, "Current date and time")
  field(DTYP, "Soft Timestamp")
  field(INP, "@%Y-%m-%d %H:%M:%S.%03f")
  field(PINI, "YES")
}

#
# % autosave 10 VAL
#
# Stores the time the calibration was last updated.
# This corresponds to the last time the user pressed Done on the calibration screen in
# our minimalistic implementation of editing functionality.
#
record(stringout, "$(P)$(R):EDIT:TIMELAST")
{
  field(DESC, "Date time string last edited")
  field(PINI, "YES")
}

# Calculation record to process the system date and time and save it as the time last edited.
record(scalcout, "$(P)$(R):EDIT:TIMECALC") 
{
  field(DESC, "Updates time of last edit.")
  field(INAA, "$(P)$(R):EDIT:TIMENOWGET PP")
  field(CALC, "AA")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
  field(PINI, "NO")
  field(OUT, "$(P)$(R):EDIT:TIMELAST PP")
}

#
# Fanout a command to synchronise the system by propagating the
# processing of the calibration table calcs through to writing to the
# pitch motor as if the translation mirror and grating selections had
# been changed on the positioners which move the real motors
# (:GRATINGSELECT and :MIRRORSELECT ), but without moving the real
# translation motors, achieved by reprocessing the internal
# calibration table positioners (prefixes:GS and :MS) instead.  This is
# necessary when editing is finished.  It depends what has been
# edited, if one of the calibration entries for the current mirror or
# grating has been changed, then the calibrated position of the pitch
# motor will jump as the calibration is applied, but none of the
# motors should move.  This only developed and tested for PITCHCAL =
# .OFF the motor record field as the recipient of the calibration.
# We know the positioner prefixes because we defined them in the our
# substitutions file, the name of the record written to, however,
# depends on the internal details of the positioner template
# implementation, unfortunately, hence the optional POSSYNC macro,
# which defaults to the name required at time of writing.
#
record(seq, "$(P)$(R):EDIT:SYNCSEQ")
{
  field(DESC, "Propagate synchronise command.")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "1" )
  field(LNK1, "$(P)$(R):GS$(POSSYNC=:SETVALUE2).PROC PP")
  field(DLY2, "3")
  field(DOL2, "1" )
  field(LNK2, "$(P)$(R):MS$(POSSYNC=:SETVALUE2).PROC PP")
  field(DLY3, "3")
  field(DOL3, "1" )
  field(LNK3, "$(P):CLB:PMATCH_DO PP")
  field(PINI, "NO")
}

# This record is to interpret the state readback from the pmatching helper PLC.
record(bi, "$(P)$(R):EDIT:PMATCHING")
{
  field(INP, "$(P):CLB:PMATCH_STATE:RBV CP")
  field(ONAM, "Matching")
  field(ZNAM, "Idle")
  field(VAL, "0")
  field(PINI, "YES")
}

# *******************************************************
# * END OF EDITING SUPPORT RECORDS
# *******************************************************
#
# A record to describe what is being calibrated for use in display screen.
# So that terms like "Beta" and "Theta" can be added to the calibration display screen.
#
record (stringout, "$(P)$(R):DESCRIPTION")
{
 field (DESC, "Description of $(PITCHDESC=Pitch)")
 field (SCAN, "Passive")
 field (VAL, "$(CLBDESC=$(P)$(PITCHMOTOR).DESC calibration)")
 field (PINI, "YES")
}

