# % macro, __doc__, AutoDecouple template from the pgmNextGen module, supporting Plane Grating Monochromators (PGMs).  They have cross-dependency between the translation and pitch motors and require extra reverse move for both mirror and grating after translation motion to free the pitch motion called decoupling (or unlatching).
# % macro, P,                   Mandatory. Device prefix for the PGM.
# % macro, DECOUPLING_DISTANCE, Mandatory. Size of extra move to achieve decoupling/unlatching.
# % macro, REAL_MOTOR,          Mandatory. Name of the real translation motor.
# % macro, SOFT_MOTOR,          Mandatory. Name of soft motor presented to user to demand translation.
# % macro, DESC,                Mandatory. Description for the DESC field on the soft motor record.
# % macro, POST_DECOUPLE_DELAY  Optional.  Defaults to zero.  Delay in seconds to allow for disengaged couple (latch) switch signal to cause pitch motor record status to get updated.
#
# Work out which direction the motor has been commanded in
record(calcout, "$(P):$(REAL_MOTOR):CHECK_DIRECTION") {
  field(DESC, "Find Direction")
  field(CALC, "A>B?1:-1")
  field(INPA, "$(P):$(SOFT_MOTOR)")
  field(INPB, "$(P):$(REAL_MOTOR).RBV")
}

# Initial move with extra move in same direction
# Additional distance is decoupling distance
record(calcout, "$(P):$(REAL_MOTOR):INITIALMOVE") {
  field(DESC, "Initial Move")
  field(CALC, "(B+(A*C))")
  field(INPA, "$(P):$(REAL_MOTOR):CHECK_DIRECTION")
  field(INPB, "$(P):$(SOFT_MOTOR)")
  field(INPC, "$(DECOUPLING_DISTANCE)")
}

# Final move back to the demanded position
# to complete the decouple move
record(calcout, "$(P):$(REAL_MOTOR):FINALMOVE") {
  field(DESC, "Final Move")
  field(CALC, "(A-(B*C))")
  field(INPA, "$(P):$(REAL_MOTOR):INITIALMOVE")
  field(INPB, "$(P):$(REAL_MOTOR):CHECK_DIRECTION")
  field(INPC, "$(DECOUPLING_DISTANCE)")
}

# Busy record for soft motor done moving
record(busy, "$(P):$(SOFT_MOTOR):DONE") {
