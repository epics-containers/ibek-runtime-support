record(transform, "$(P,recursive):CLB:MIR:M5:UPD") {
  field(CLCE, "ABS(D-A)<=C")
  field(CLCF, "ABS(D-B)<=C")
  field(INPA, "$(P,recursive):CLB:MIR:M5_CAL")
  field(INPB, "$(P,recursive):CLB:MIR:M5:SETVALUE.VAL")
  field(INPC, "0")
  field(INPD, "$(P,recursive):CLB:MIR:M5_CAL CP MS")
  field(OUTE, "$(P,recursive):CLB:MIR:M5:DMOV PP MS")
  field(OUTF, "$(P,recursive):CLB:MIR:M5:INPOS PP MS")
  field(EGU, "$(PITCHEGU=deg)")
  field(PREC, "$(PITCHPREC=8)")
}

