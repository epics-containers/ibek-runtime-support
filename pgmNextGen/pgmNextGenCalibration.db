# File pgmNextGenCal.template
#
# % macro, __doc__, Part of implementation of calibration table for PGM Mirror and Grating Pitch Offsets with different Grating line density and Mirror stripe selections. (It is mostly done with positioners).
#
# % macro, P,          Mandatory.  Device prefix for record names.
# % macro, R,          Mandatory.  Record prefix for calibration record names. (Calibration records start <P><R>)
# % macro, PITCHMOTOR, Mandatory.  Record prefix of pitch motor. (Full record name constructed as <P><PITCHMOTOR>).
#
# % macro, PITCHDESC,  Optional.   Description of pitch motor.			Defaults to Pitch
# % macro, PITCHCAL,   Optional.   Definition of what field to set.  	      	Defaults to .OFF
# % macro, PITCHEGU,   Optional.   Engineering units for the pitch.  	       	Defaults to deg.
# % macro, PITCHPREC,  Optional.   Display precision for the pitch.  	       	Defaults to 8.
# % macro, POSSYNC,    Optional.   Which record in positioner template to set.	Defaults to :SETVALUE2
# % macro, CLBDESC,    Optional.   Descriptive label of calibration table.     	Defaults to <P><PITCHMOTOR>.DESC Calibn.
#
# The record names had to be kept shorter than preferred because of problems with link definition string character number 
# limit imposed by EPICS in records from the positioner template.
#
# The decision to construct the name of the motor record from the device name prefix P as commented above is because of keeping the style
# of use of the macros consistent with the existing template and substitution files, but introduces the assumption that all the motors 
# (and therefore the calibration records and other positioners) share the same device prefix, which is a reasonable assumption.
# 
# *******************************************************
# * START OF RECORDS FOR CALIBRATION CELL SELECTION 
# *******************************************************
#
# The currently selected value of the pitch motor offset for M1 being in operation implied from the current grating selection
#
record (ai, "$(P,recursive):CLB:GRT:M1_CAL")
{
  field (DESC, "$(GRATINGDESC=Grating Pitch) Mir1 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:GRT:M_CAL")
}

# The currently selected value of the pitch motor offset for M2 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:GRT:M2_CAL")
{
  field (DESC, "$(GRATINGDESC=Grating Pitch) Mir2 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:GRT:M_CAL")
}

# The currently selected value of the pitch motor offset for M3 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:GRT:M3_CAL")
{
  field (DESC, "$(GRATINGDESC=Grating Pitch) Mir3 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:GRT:M_CAL")
}

# The currently selected value of the pitch motor offset for M4 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:GRT:M4_CAL")
{
  field (DESC, "$(GRATINGDESC=Grating Pitch) Mir4 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:GRT:M_CAL")
}

# The currently selected value of the pitch motor offset for M5 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:GRT:M5_CAL")
{
  field (DESC, "$(GRATINGDESC=Grating Pitch) Mir5 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:GRT:M_CAL")
}

#
# The currently selected value of the pitch motor offset implied from 
# the current mirror in operation (which in turn are implied from current 
# grating selection via records in the input links) is written to the
# pitch motor record.
#
# Provision of the PITCHCAL macro is a bit of defensive programming in
# case ever want to use the adjustment offset parameters provided in
# the co-ordinate system (i.e. a small fudge factor on a standard
# offset like BL06I does with its OMS system) instead of the motor
# record offsets directly as has been specified for BL05I.  The motor
# offsets have the advantage they will work for a beamline using the
# EPICS soft motors instead of the co-ordinate system implementation.
#
# So by judicious changes to the PITCHMOTOR, PITCHCAL and the
# calibration table macro definitions in the IOC build could do that
# here with no programming changes to this template (but the variables
# for them need to get implemented in the main database, which I think
# they are not at present).
#
record (sel, "$(P,recursive):CLB:GRT:M_CAL")
{
 field (DESC, "$(GRATINGDESC=Grating Pitch) calib selected.")
 field (SELM, "Specified")
 field (INPA, "$(P,recursive):CLB:GRT:M1_CAL")
 field (INPB, "$(P,recursive):CLB:GRT:M2_CAL")
 field (INPC, "$(P,recursive):CLB:GRT:M3_CAL")
 field (INPD, "$(P,recursive):CLB:GRT:M4_CAL")
 field (INPE, "$(P,recursive):CLB:GRT:M5_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (FLNK, "$(P,recursive):CLB:GRT:SET:PITCHCAL")
}

#
# The sel record does not have an OUT field to write its value onwards,
# therefore need something to do that for us.
# We could convert the whole thing to a calcout or a transform but prefer
# to avoid mysterious calculations by using base records.
#
record (ao, "$(P,recursive):CLB:GRT:SET:PITCHCAL")
{
 field (DESC, "Apply $(GRATINGDESC=Grating Pitch) calibn.")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (OIF, "Full")
 field (DOL, "$(P,recursive):CLB:GRT:M_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (OUT, "$(P,recursive):$(GRATINGPITCH,undefined)$(GRATINGCAL=.OFF)")
}

# *******************************************************
# * END OF RECORDS FOR CALIBRATION CELL SELECTION 
# *******************************************************
#
# *******************************************************
# * START OF EDITING SUPPORT RECORDS
# *******************************************************
# * 
# * The user needs to be able to set the calibration entries,
# * so need extra records to support visibility changes on the GUI
# * screens.
# * 
# * Also the original processing chain was designed and tested
# * to ensure changes were propagated when the grating and mirror
# * were selected via their multipositioners which move the 
# * translation motors.  To extend to support editing need to monitor 
# * when user finishes and retrigger some processing.  
# * 
# *******************************************************
#
# % autosave 1 VAL
#
# Are there changes pending? 
#
# We need a widget to remind the user they must click Done on the
# calibration screen to apply the changes, this record supports that.
#
# This is a bituvva cheat because:
# (a) The processing to propagate any changes and clear this pending PV
#     will be done when the user clicks Done on the calibration screen
#     in any case, i.e. it ignores this PV.
# (b) We assume that if the user clicks the column edit button on the
#     calibration table screen then there are changes pending whether
#     or not the user has changed anything.
# (c) Apparent madness, we also set this when the user clicks the Done
#     button on the column edit screen, but there is method.  This is
#     a defensive measure because the EDM screens do not block, so if
#     the user does things in a slightly different order to that
#     anticipated it is possible to get in a muddle otherwise.  A
#     determined effort to subvert the editing system could still
#     produce confusing behaviour, but at least have attempted to be
#     robust.
# 
record(bo, "$(P,recursive):CLB:GRT:EDIT:PENDING")
{
  field(DESC, "Edits of $(GRATINGDESC=Grating Pitch) Pending")
  field(ZNAM, "None")
  field(ONAM, "Pending")
  field(VAL, "0")
  field(PINI, "YES")
}

#
# Clear the changes pending record (set it to zero).
#
record (bo, "$(P,recursive):CLB:GRT:EDIT:PENDINGCLEAR")
{
 field (DESC, "Clear changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "0")
 field (OUT, "$(P,recursive):CLB:GRT:EDIT:PENDING PP")
}

#
# Set the changes pending PV (set it to one).
#
record (bo, "$(P,recursive):CLB:GRT:EDIT:PENDINGSET")
{
 field (DESC, "Set changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "1")
 field (OUT, "$(P,recursive):CLB:GRT:EDIT:PENDING PP")
}

#
# % autosave 1 VAL
#
# Edit Mode record supports entering Edit mode on the calibration table screen.
# The GUI writes to set the value of this record and it has extra widgets which appear
# dependent on this record.  Onward processing actions the change of mode in the database.
#
# Initialise to not in Edit mode.
# 0 for Done Editing i.e. not in Edit Mode.
# 1 for Edit         i.e. in Edit Mode.
# 
record(bo, "$(P,recursive):CLB:GRT:EDIT:MODE")
{
  field(DESC, "Control Editing of $(GRATINGDESC=Grating Pitch)")
  field(ZNAM, "Done")
  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P,recursive):CLB:GRT:EDIT:MODECALC PP")
}

#
# Calculate an action code on change of the EDIT mode state.
# The MODE is a binary, but the MODEACTIONFAN action selection fanout needs link numbers starting from 1.
#
record(calcout, "$(P,recursive):CLB:GRT:EDIT:MODECALC") 
{
  field(DESC, "React to edit mode change")
  field(INPA, "$(P,recursive):CLB:GRT:EDIT:MODE NPP")
  field(OOPT, "On Change")
  field(CALC, "A+1")
  field(PINI, "NO")
  field(OUT, "$(P,recursive):CLB:GRT:EDIT:MODEACTION PP" )
}

#
# To hold the calculated action code.
# 1 for Done,
# 2 for Edit.
#
# This record was clearly originally intended to be a bo not an ao,
# but it has been ao since first prod version of the template and I dont
# have time to test changing it to bo.  The ZNAM and ONAM fields were not
# before, but are now causing errors in the bootlog (EPICS base update??) 
# when the database is loaded as the ao record does not have these fields.
# Clearly it works as an ao, so am commenting out the problem fields for 
# now to shut up the errors.
#
record(ao, "$(P,recursive):CLB:GRT:EDIT:MODEACTION")
{
  field(DESC, "Control Editing of $(GRATINGDESC=Grating Pitch)")
#  field(ZNAM, "Done")
#  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONFAN PP")
}

#
# Select which action to do (enter or leave edit mode).
# Uses the link selection functionality of the fanout record.
# 1 for Done
# 2 for Edit
#
record(fanout, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONFAN")
{
  field(DESC, "Select mode action.")
  field(SCAN, "Passive")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):CLB:GRT:EDIT:MODEACTION")
  field(LNK1, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONDONE")
  field(LNK2, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONEDIT")
}

#
# The Done Action for the calibration table screen.
# LNK1 Update timestamp of last edit.
# LNK2 Sends out command to synchronise all the internal calibration
#      tables and the pitch motor calibration.  This might cause the
#      pitch motor position to jump, but NOT to move and neither
#      should the translation motors.
# LNK3 Clears the changes pending record to remove the message from
#      the calibration table screen.
#
record(seq, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONDONE")
{
  field(DESC, "Finish editing $(GRATINGDESC=Grating Pitch)")
  field(DOL1, "1")
  field(LNK1, "$(P,recursive):CLB:GRT:EDIT:TIMECALC.PROC PP")
  field(DOL2, "1")
  field(LNK2, "$(P,recursive):CLB:GRT:EDIT:SYNCSEQ.PROC PP")
  field(DLY3, "5")
  field(DOL3, "1")
  field(LNK3, "$(P,recursive):CLB:GRT:EDIT:PENDINGCLEAR.PROC PP")
}

#
# The Edit Action for the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONEDIT")
{
  field(DESC, "Start editing $(GRATINGDESC=Grating Pitch)")
}

#
# We dont currently need this because 
# (a) We do not toggle control to edit on the column edit screen
# (b) We ignore the PENDING record in calculations
# (c) We provide no extra records for the desired values, instead 
#     the column edit screen writes directly into the existing positioner records.
# The GUI screens write directly to the ACTION records instead.
#
#record(fanout, "$(P,recursive):CLB:GRT:EDIT:COLACTIONFAN")
#{
#  field(DESC, "Select column action.")
#  field(SCAN, "Passive")
#  field(SELM, "Specified")
#  field(SELL, "$(P,recursive):CLB:GRT:EDIT:MODEACTION")
#  field(LNK1, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONDONE PP")
#  field(LNK2, "$(P,recursive):CLB:GRT:EDIT:MODEACTIONEDIT PP")
#}
#
# The Done Action for the calibration Calibration Column Edit screen.
# We assume changes are pending whether or not the user actually changed any numbers.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:GRT:EDIT:COLACTIONDONE")
{
  field(DESC, "Finish a Mirror Column edit")
  field(LNK1, "$(P,recursive):CLB:GRT:EDIT:PENDINGSET PP")
}

#
# The Edit Action on starting the calibration Mirror Column Edit screen by pressing
# one of the Edit buttons on the calibration table screen.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:GRT:EDIT:COLACTIONEDIT")
{
  field(DESC, "Start Mirror Column edit")
  field(LNK1, "$(P,recursive):CLB:GRT:EDIT:PENDINGSET PP")
}

#
# To get a timestamp string. Needed to store when the last edit was done.
# This will probably only be true if the user has used the GUI to do the editing.
# If scripted caputs to the positioner values have been used, this will have been bypassed.
# This documentation on the Soft Timestamp DTYP is hard to find, followed an example
# from Tech Talk archives.
#
record(stringin, "$(P,recursive):CLB:GRT:EDIT:TIMENOWGET") 
{
  field(DESC, "Current date and time")
  field(DTYP, "Soft Timestamp")
  field(INP, "@%Y-%m-%d %H:%M:%S.%03f")
  field(PINI, "YES")
}

#
# % autosave 10 VAL
#
# Stores the time the calibration was last updated.
# This corresponds to the last time the user pressed Done on the calibration screen in
# our minimalistic implementation of editing functionality.
#
record(stringout, "$(P,recursive):CLB:GRT:EDIT:TIMELAST")
{
  field(DESC, "Date time string last edited")
  field(PINI, "YES")
}

# Calculation record to process the system date and time and save it as the time last edited.
record(scalcout, "$(P,recursive):CLB:GRT:EDIT:TIMECALC") 
{
  field(DESC, "Updates time of last edit.")
  field(INAA, "$(P,recursive):CLB:GRT:EDIT:TIMENOWGET PP")
  field(CALC, "AA")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
  field(PINI, "NO")
  field(OUT, "$(P,recursive):CLB:GRT:EDIT:TIMELAST PP")
}

#
# Fanout a command to synchronise the system by propagating the
# processing of the calibration table calcs through to writing to the
# pitch motor as if the translation mirror and grating selections had
# been changed on the positioners which move the real motors
# (:GRATINGSELECT and :MIRRORSELECT ), but without moving the real
# translation motors, achieved by reprocessing the internal
# calibration table positioners (prefixes:GS and :MS) instead.  This is
# necessary when editing is finished.  It depends what has been
# edited, if one of the calibration entries for the current mirror or
# grating has been changed, then the calibrated position of the pitch
# motor will jump as the calibration is applied, but none of the
# motors should move.  This only developed and tested for PITCHCAL =
# .OFF the motor record field as the recipient of the calibration.
# We know the positioner prefixes because we defined them in the our
# substitutions file, the name of the record written to, however,
# depends on the internal details of the positioner template
# implementation, unfortunately, hence the optional POSSYNC macro,
# which defaults to the name required at time of writing.
#
record(seq, "$(P,recursive):CLB:GRT:EDIT:SYNCSEQ")
{
  field(DESC, "Propagate synchronise command.")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "1" )
  field(LNK1, "$(P,recursive):CLB:GRT:GS:SETVALUE2.PROC PP")
  field(DLY2, "3")
  field(DOL2, "1" )
  field(LNK2, "$(P,recursive):CLB:GRT:MS:SETVALUE2.PROC PP")
  field(DLY3, "3")
  field(DOL3, "1" )
  field(LNK3, "$(P,recursive):CLB:PMATCH_DO PP")
  field(PINI, "NO")
}

# This record is to interpret the state readback from the pmatching helper PLC.
record(bi, "$(P,recursive):CLB:GRT:EDIT:PMATCHING")
{
  field(INP, "$(P,recursive):CLB:PMATCH_STATE:RBV CP")
  field(ONAM, "Matching")
  field(ZNAM, "Idle")
  field(VAL, "0")
  field(PINI, "YES")
}

# *******************************************************
# * END OF EDITING SUPPORT RECORDS
# *******************************************************
#
# A record to describe what is being calibrated for use in display screen.
# So that terms like "Beta" and "Theta" can be added to the calibration display screen.
#
record (stringout, "$(P,recursive):CLB:GRT:DESCRIPTION")
{
 field (DESC, "Description of $(GRATINGDESC=Grating Pitch)")
 field (SCAN, "Passive")
 field (VAL, "$(GRTCLBDESC=Grating - Beta Calibration)")
 field (PINI, "YES")
}

# File pgmNextGenCal.template
#
# % macro, __doc__, Part of implementation of calibration table for PGM Mirror and Grating Pitch Offsets with different Grating line density and Mirror stripe selections. (It is mostly done with positioners).
#
# % macro, P,          Mandatory.  Device prefix for record names.
# % macro, R,          Mandatory.  Record prefix for calibration record names. (Calibration records start <P><R>)
# % macro, PITCHMOTOR, Mandatory.  Record prefix of pitch motor. (Full record name constructed as <P><PITCHMOTOR>).
#
# % macro, PITCHDESC,  Optional.   Description of pitch motor.			Defaults to Pitch
# % macro, PITCHCAL,   Optional.   Definition of what field to set.  	      	Defaults to .OFF
# % macro, PITCHEGU,   Optional.   Engineering units for the pitch.  	       	Defaults to deg.
# % macro, PITCHPREC,  Optional.   Display precision for the pitch.  	       	Defaults to 8.
# % macro, POSSYNC,    Optional.   Which record in positioner template to set.	Defaults to :SETVALUE2
# % macro, CLBDESC,    Optional.   Descriptive label of calibration table.     	Defaults to <P><PITCHMOTOR>.DESC Calibn.
#
# The record names had to be kept shorter than preferred because of problems with link definition string character number 
# limit imposed by EPICS in records from the positioner template.
#
# The decision to construct the name of the motor record from the device name prefix P as commented above is because of keeping the style
# of use of the macros consistent with the existing template and substitution files, but introduces the assumption that all the motors 
# (and therefore the calibration records and other positioners) share the same device prefix, which is a reasonable assumption.
# 
# *******************************************************
# * START OF RECORDS FOR CALIBRATION CELL SELECTION 
# *******************************************************
#
# The currently selected value of the pitch motor offset for M1 being in operation implied from the current grating selection
#
record (ai, "$(P,recursive):CLB:MIR:M1_CAL")
{
  field (DESC, "$(MIRRORDESC=Mirror Pitch) Mir1 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:MIR:M_CAL")
}

# The currently selected value of the pitch motor offset for M2 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:MIR:M2_CAL")
{
  field (DESC, "$(MIRRORDESC=Mirror Pitch) Mir2 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:MIR:M_CAL")
}

# The currently selected value of the pitch motor offset for M3 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:MIR:M3_CAL")
{
  field (DESC, "$(MIRRORDESC=Mirror Pitch) Mir3 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:MIR:M_CAL")
}

# The currently selected value of the pitch motor offset for M4 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:MIR:M4_CAL")
{
  field (DESC, "$(MIRRORDESC=Mirror Pitch) Mir4 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:MIR:M_CAL")
}

# The currently selected value of the pitch motor offset for M5 being in operation implied from the current grating selection.
record (ai, "$(P,recursive):CLB:MIR:M5_CAL")
{
  field (DESC, "$(MIRRORDESC=Mirror Pitch) Mir5 selected.")
  field (EGU, "$(PITCHEGU=deg)")
  field (PREC, "$(PITCHPREC=8)")
  field (FLNK, "$(P,recursive):CLB:MIR:M_CAL")
}

#
# The currently selected value of the pitch motor offset implied from 
# the current mirror in operation (which in turn are implied from current 
# grating selection via records in the input links) is written to the
# pitch motor record.
#
# Provision of the PITCHCAL macro is a bit of defensive programming in
# case ever want to use the adjustment offset parameters provided in
# the co-ordinate system (i.e. a small fudge factor on a standard
# offset like BL06I does with its OMS system) instead of the motor
# record offsets directly as has been specified for BL05I.  The motor
# offsets have the advantage they will work for a beamline using the
# EPICS soft motors instead of the co-ordinate system implementation.
#
# So by judicious changes to the PITCHMOTOR, PITCHCAL and the
# calibration table macro definitions in the IOC build could do that
# here with no programming changes to this template (but the variables
# for them need to get implemented in the main database, which I think
# they are not at present).
#
record (sel, "$(P,recursive):CLB:MIR:M_CAL")
{
 field (DESC, "$(MIRRORDESC=Mirror Pitch) calib selected.")
 field (SELM, "Specified")
 field (INPA, "$(P,recursive):CLB:MIR:M1_CAL")
 field (INPB, "$(P,recursive):CLB:MIR:M2_CAL")
 field (INPC, "$(P,recursive):CLB:MIR:M3_CAL")
 field (INPD, "$(P,recursive):CLB:MIR:M4_CAL")
 field (INPE, "$(P,recursive):CLB:MIR:M5_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (FLNK, "$(P,recursive):CLB:MIR:SET:PITCHCAL")
}

#
# The sel record does not have an OUT field to write its value onwards,
# therefore need something to do that for us.
# We could convert the whole thing to a calcout or a transform but prefer
# to avoid mysterious calculations by using base records.
#
record (ao, "$(P,recursive):CLB:MIR:SET:PITCHCAL")
{
 field (DESC, "Apply $(MIRRORDESC=Mirror Pitch) calibn.")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (OIF, "Full")
 field (DOL, "$(P,recursive):CLB:MIR:M_CAL")
 field (EGU, "$(PITCHEGU=deg)")
 field (PREC, "$(PITCHPREC=8)")
 field (OUT, "$(P,recursive):$(MIRRORPITCH,undefined)$(MIRRORCAL=.OFF)")
}

# *******************************************************
# * END OF RECORDS FOR CALIBRATION CELL SELECTION 
# *******************************************************
#
# *******************************************************
# * START OF EDITING SUPPORT RECORDS
# *******************************************************
# * 
# * The user needs to be able to set the calibration entries,
# * so need extra records to support visibility changes on the GUI
# * screens.
# * 
# * Also the original processing chain was designed and tested
# * to ensure changes were propagated when the grating and mirror
# * were selected via their multipositioners which move the 
# * translation motors.  To extend to support editing need to monitor 
# * when user finishes and retrigger some processing.  
# * 
# *******************************************************
#
# % autosave 1 VAL
#
# Are there changes pending? 
#
# We need a widget to remind the user they must click Done on the
# calibration screen to apply the changes, this record supports that.
#
# This is a bituvva cheat because:
# (a) The processing to propagate any changes and clear this pending PV
#     will be done when the user clicks Done on the calibration screen
#     in any case, i.e. it ignores this PV.
# (b) We assume that if the user clicks the column edit button on the
#     calibration table screen then there are changes pending whether
#     or not the user has changed anything.
# (c) Apparent madness, we also set this when the user clicks the Done
#     button on the column edit screen, but there is method.  This is
#     a defensive measure because the EDM screens do not block, so if
#     the user does things in a slightly different order to that
#     anticipated it is possible to get in a muddle otherwise.  A
#     determined effort to subvert the editing system could still
#     produce confusing behaviour, but at least have attempted to be
#     robust.
# 
record(bo, "$(P,recursive):CLB:MIR:EDIT:PENDING")
{
  field(DESC, "Edits of $(MIRRORDESC=Mirror Pitch) Pending")
  field(ZNAM, "None")
  field(ONAM, "Pending")
  field(VAL, "0")
  field(PINI, "YES")
}

#
# Clear the changes pending record (set it to zero).
#
record (bo, "$(P,recursive):CLB:MIR:EDIT:PENDINGCLEAR")
{
 field (DESC, "Clear changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "0")
 field (OUT, "$(P,recursive):CLB:MIR:EDIT:PENDING PP")
}

#
# Set the changes pending PV (set it to one).
#
record (bo, "$(P,recursive):CLB:MIR:EDIT:PENDINGSET")
{
 field (DESC, "Set changes pending")
 field (DTYP, "Soft Channel")
 field (SCAN, "Passive")
 field (OMSL, "closed_loop")
 field (DOL, "1")
 field (OUT, "$(P,recursive):CLB:MIR:EDIT:PENDING PP")
}

#
# % autosave 1 VAL
#
# Edit Mode record supports entering Edit mode on the calibration table screen.
# The GUI writes to set the value of this record and it has extra widgets which appear
# dependent on this record.  Onward processing actions the change of mode in the database.
#
# Initialise to not in Edit mode.
# 0 for Done Editing i.e. not in Edit Mode.
# 1 for Edit         i.e. in Edit Mode.
# 
record(bo, "$(P,recursive):CLB:MIR:EDIT:MODE")
{
  field(DESC, "Control Editing of $(MIRRORDESC=Mirror Pitch)")
  field(ZNAM, "Done")
  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P,recursive):CLB:MIR:EDIT:MODECALC PP")
}

#
# Calculate an action code on change of the EDIT mode state.
# The MODE is a binary, but the MODEACTIONFAN action selection fanout needs link numbers starting from 1.
#
record(calcout, "$(P,recursive):CLB:MIR:EDIT:MODECALC") 
{
  field(DESC, "React to edit mode change")
  field(INPA, "$(P,recursive):CLB:MIR:EDIT:MODE NPP")
  field(OOPT, "On Change")
  field(CALC, "A+1")
  field(PINI, "NO")
  field(OUT, "$(P,recursive):CLB:MIR:EDIT:MODEACTION PP" )
}

#
# To hold the calculated action code.
# 1 for Done,
# 2 for Edit.
#
# This record was clearly originally intended to be a bo not an ao,
# but it has been ao since first prod version of the template and I dont
# have time to test changing it to bo.  The ZNAM and ONAM fields were not
# before, but are now causing errors in the bootlog (EPICS base update??) 
# when the database is loaded as the ao record does not have these fields.
# Clearly it works as an ao, so am commenting out the problem fields for 
# now to shut up the errors.
#
record(ao, "$(P,recursive):CLB:MIR:EDIT:MODEACTION")
{
  field(DESC, "Control Editing of $(MIRRORDESC=Mirror Pitch)")
#  field(ZNAM, "Done")
#  field(ONAM, "Edit")
  field(VAL, "0")
  field(PINI, "YES")
  field(FLNK, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONFAN PP")
}

#
# Select which action to do (enter or leave edit mode).
# Uses the link selection functionality of the fanout record.
# 1 for Done
# 2 for Edit
#
record(fanout, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONFAN")
{
  field(DESC, "Select mode action.")
  field(SCAN, "Passive")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):CLB:MIR:EDIT:MODEACTION")
  field(LNK1, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONDONE")
  field(LNK2, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONEDIT")
}

#
# The Done Action for the calibration table screen.
# LNK1 Update timestamp of last edit.
# LNK2 Sends out command to synchronise all the internal calibration
#      tables and the pitch motor calibration.  This might cause the
#      pitch motor position to jump, but NOT to move and neither
#      should the translation motors.
# LNK3 Clears the changes pending record to remove the message from
#      the calibration table screen.
#
record(seq, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONDONE")
{
  field(DESC, "Finish editing $(MIRRORDESC=Mirror Pitch)")
  field(DOL1, "1")
  field(LNK1, "$(P,recursive):CLB:MIR:EDIT:TIMECALC.PROC PP")
  field(DOL2, "1")
  field(LNK2, "$(P,recursive):CLB:MIR:EDIT:SYNCSEQ.PROC PP")
  field(DLY3, "5")
  field(DOL3, "1")
  field(LNK3, "$(P,recursive):CLB:MIR:EDIT:PENDINGCLEAR.PROC PP")
}

#
# The Edit Action for the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONEDIT")
{
  field(DESC, "Start editing $(MIRRORDESC=Mirror Pitch)")
}

#
# We dont currently need this because 
# (a) We do not toggle control to edit on the column edit screen
# (b) We ignore the PENDING record in calculations
# (c) We provide no extra records for the desired values, instead 
#     the column edit screen writes directly into the existing positioner records.
# The GUI screens write directly to the ACTION records instead.
#
#record(fanout, "$(P,recursive):CLB:MIR:EDIT:COLACTIONFAN")
#{
#  field(DESC, "Select column action.")
#  field(SCAN, "Passive")
#  field(SELM, "Specified")
#  field(SELL, "$(P,recursive):CLB:MIR:EDIT:MODEACTION")
#  field(LNK1, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONDONE PP")
#  field(LNK2, "$(P,recursive):CLB:MIR:EDIT:MODEACTIONEDIT PP")
#}
#
# The Done Action for the calibration Calibration Column Edit screen.
# We assume changes are pending whether or not the user actually changed any numbers.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:MIR:EDIT:COLACTIONDONE")
{
  field(DESC, "Finish a Mirror Column edit")
  field(LNK1, "$(P,recursive):CLB:MIR:EDIT:PENDINGSET PP")
}

#
# The Edit Action on starting the calibration Mirror Column Edit screen by pressing
# one of the Edit buttons on the calibration table screen.
# LNK1 Sets the changes pending record to make sure there is a message
#      on the calibration table screen.
#
record(fanout, "$(P,recursive):CLB:MIR:EDIT:COLACTIONEDIT")
{
  field(DESC, "Start Mirror Column edit")
  field(LNK1, "$(P,recursive):CLB:MIR:EDIT:PENDINGSET PP")
}

#
# To get a timestamp string. Needed to store when the last edit was done.
# This will probably only be true if the user has used the GUI to do the editing.
# If scripted caputs to the positioner values have been used, this will have been bypassed.
# This documentation on the Soft Timestamp DTYP is hard to find, followed an example
# from Tech Talk archives.
#
record(stringin, "$(P,recursive):CLB:MIR:EDIT:TIMENOWGET") 
{
  field(DESC, "Current date and time")
  field(DTYP, "Soft Timestamp")
  field(INP, "@%Y-%m-%d %H:%M:%S.%03f")
  field(PINI, "YES")
}

#
# % autosave 10 VAL
#
# Stores the time the calibration was last updated.
# This corresponds to the last time the user pressed Done on the calibration screen in
# our minimalistic implementation of editing functionality.
#
record(stringout, "$(P,recursive):CLB:MIR:EDIT:TIMELAST")
{
  field(DESC, "Date time string last edited")
  field(PINI, "YES")
}

# Calculation record to process the system date and time and save it as the time last edited.
record(scalcout, "$(P,recursive):CLB:MIR:EDIT:TIMECALC") 
{
  field(DESC, "Updates time of last edit.")
  field(INAA, "$(P,recursive):CLB:MIR:EDIT:TIMENOWGET PP")
  field(CALC, "AA")
  field(OOPT, "Every Time")
  field(DOPT, "Use CALC")
  field(PINI, "NO")
  field(OUT, "$(P,recursive):CLB:MIR:EDIT:TIMELAST PP")
}

#
# Fanout a command to synchronise the system by propagating the
# processing of the calibration table calcs through to writing to the
# pitch motor as if the translation mirror and grating selections had
# been changed on the positioners which move the real motors
# (:GRATINGSELECT and :MIRRORSELECT ), but without moving the real
# translation motors, achieved by reprocessing the internal
# calibration table positioners (prefixes:GS and :MS) instead.  This is
# necessary when editing is finished.  It depends what has been
# edited, if one of the calibration entries for the current mirror or
# grating has been changed, then the calibrated position of the pitch
# motor will jump as the calibration is applied, but none of the
# motors should move.  This only developed and tested for PITCHCAL =
# .OFF the motor record field as the recipient of the calibration.
# We know the positioner prefixes because we defined them in the our
# substitutions file, the name of the record written to, however,
# depends on the internal details of the positioner template
# implementation, unfortunately, hence the optional POSSYNC macro,
# which defaults to the name required at time of writing.
#
record(seq, "$(P,recursive):CLB:MIR:EDIT:SYNCSEQ")
{
  field(DESC, "Propagate synchronise command.")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "1" )
  field(LNK1, "$(P,recursive):CLB:MIR:GS:SETVALUE2.PROC PP")
  field(DLY2, "3")
  field(DOL2, "1" )
  field(LNK2, "$(P,recursive):CLB:MIR:MS:SETVALUE2.PROC PP")
  field(DLY3, "3")
  field(DOL3, "1" )
  field(LNK3, "$(P,recursive):CLB:PMATCH_DO PP")
  field(PINI, "NO")
}

# This record is to interpret the state readback from the pmatching helper PLC.
record(bi, "$(P,recursive):CLB:MIR:EDIT:PMATCHING")
{
  field(INP, "$(P,recursive):CLB:PMATCH_STATE:RBV CP")
  field(ONAM, "Matching")
  field(ZNAM, "Idle")
  field(VAL, "0")
  field(PINI, "YES")
}

# *******************************************************
# * END OF EDITING SUPPORT RECORDS
# *******************************************************
#
# A record to describe what is being calibrated for use in display screen.
# So that terms like "Beta" and "Theta" can be added to the calibration display screen.
#
record (stringout, "$(P,recursive):CLB:MIR:DESCRIPTION")
{
 field (DESC, "Description of $(MIRRORDESC=Mirror Pitch)")
 field (SCAN, "Passive")
 field (VAL, "$(MIRCLBDESC=Mirror - Theta Calibration)")
 field (PINI, "YES")
}

