  field(DESC, "Disable proc once done")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):CLB:GRT:GS:CALCSEL")
  field(VAL, "1")
  field(OUT, "$(P,recursive):CLB:GRT:GS:SETINPUT1.DISA")
}

