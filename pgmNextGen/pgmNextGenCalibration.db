# This record contains the list of positions for motor.
# The multipositioner writes to the VAL field to select one.
record(longout, "$(P,recursive):CLB:GRT:M3:SEL") {
  field(DESC, "Grating M3 Calibration Table")
  field(FLNK, "$(P,recursive):CLB:GRT:M3:SELCALC1")
}

record(calcout, "$(P,recursive):CLB:GRT:M3:SELCALC1") {
  field(FLNK, "$(P,recursive):CLB:GRT:M3:SELCALC2")
  field(CALC, "A<12?1:0")
  field(INPA, "$(P,recursive):CLB:GRT:M3:SEL.VAL")
  field(OUT, "$(P,recursive):CLB:GRT:M3:SEL1.SELN PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
}

record(ao, "$(P,recursive):CLB:GRT:M3:SEL1COPY") {
  field(DOL, "$(P,recursive):CLB:GRT:M3:SEL1.VAL")
  field(OMSL, "closed_loop")
  field(PREC, "$(PITCHPREC=8)")
  field(OUT, "$(P,recursive):CLB:GRT:M3:SETVALUE PP")
  field(EGU, "$(PITCHEGU=deg)")
}

record(sel, "$(P,recursive):CLB:GRT:M3:SEL2") {
  field(DESC, "Grating M3 Calibration Table")
  field(FLNK, "$(P,recursive):CLB:GRT:M3:SEL2COPY")
  field(SELM, "Specified")
  field(PREC, "$(PITCHPREC=8)")
  field(EGU, "$(PITCHEGU=deg)")
}

record(ao, "$(P,recursive):CLB:GRT:M3:SEL2COPY") {
