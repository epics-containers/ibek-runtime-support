# % macro, __doc__, Template for wrapping any pv as a positioner. This allows 
# it to be controlled by a multipositioner, mapping a list of names onto a 
# list of values for this pv
# % macro, P, Device prefix, must match P of multipositioner
# % macro, Q, Device suffix
# % macro, MP, Multipositioner suffix, must match MP of multipositioner
# % macro, DESC, Positioner description
# % macro, SET, Pv used to set the value
# % macro, EGU, Engineering units
# % macro, PREC, Precision to display to
# % macro, READBACK, Pv used to readback the value
# % macro, STOP, STOPVAL written to this Pv to stop movement
# % macro, STOPVAL, The value written to STOP to stop movement
# % macro, DEADBAND, In position if abs(demand - readback) < DEADBAND
# % macro, VALA, Positioner value for position 1
# % macro, VALB, Positioner value for position 2
# % macro, VALC, Positioner value for position 3
# % macro, VALD, Positioner value for position 4
# % macro, VALE, Positioner value for position 5
# % macro, VALF, Positioner value for position 6
# % macro, VALG, Positioner value for position 7
# % macro, VALH, Positioner value for position 8
# % macro, VALI, Positioner value for position 9
# % macro, VALJ, Positioner value for position 10
# % macro, VALK, Positioner value for position 11
# % macro, VALL, Positioner value for position 12
# % macro, VALM, Positioner value for position 13
# % macro, VALN, Positioner value for position 14
# % macro, VALO, Positioner value for position 15
# % macro, VALP, Positioner value for position 16
# % macro, pos, Positioner letter (A..H)
# This record sets the first input link from the multipositioner.
# This decouples the two templates.
# The output can only be set after initialisation. Hence this runs on a scan.
# After running once it is disabled.
record(stringout, "$(P,recursive):CLB:MIR:MS:SETINPUT1") {
  field(DESC, "Set output link from above")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):CLB:MIR:MS:SETINPUT2")
  field(VAL, "$(P,recursive):CLB:MIR:MS:SEL PP")
  field(OUT, "$(P,recursive):MIRRORSELECT:DFANOUTA.OUTD CA")
  field(SCAN, "1 second")
}

record(calcout, "$(P,recursive):CLB:MIR:MS:CALCSEL") {
  field(CALC, "A")
  field(INPA, "$(P,recursive):MIRRORSELECT:SELECT")
  field(OUT, "$(P,recursive):CLB:MIR:MS:SEL PP")
  field(DISV, "0")
  field(SDIS, "$(P,recursive):CLB:MIR:MS:SETINPUT1.DISA")
}
##############################################################
#
# Template to write and read a variable on a PMAC/Geobrick.
#
##############################################################

# Macros
# % macro, __doc__, Simple template that reads and writes to a variable on a 
# PMAC or geoBrick via dynamic parameters.
# % macro, name, Object name and gui association name
# % macro, P, Pv Prefix
# % macro, Q, Pv Suffix
# % macro, DTYP, asyn DTYP (e.g., asynFloat64, asynInt32)
# % macro, PORT, Motor controller serial port
# % macro, TYPE, PMAC variable type (D=double, I=integer, H=hex, S=string)
# % macro, VAR, Variable on PMAC to write to, e.g. P700
# % macro, EGU, Engineering units
# % macro, VARIABLE_PREC, Variable Record precision
# % macro, LABEL, Label for GUI

# CSS GUI
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed_box.opi, P=$(P,recursive),Q=:CLB:PMATCH_STATE,LABEL=$(LABEL,undefined), name=
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed.opi, P=$(P,recursive),Q=:CLB:PMATCH_STATE,LABEL=$(LABEL,undefined), name=

# EGM GUI
# % gui, , edmembed, pmacVariableWrite.edl, P=$(P,recursive), Q=:CLB:PMATCH_STATE, LABEL=$(LABEL,undefined)

##########################################
# Records for writing to PMAC variables
########################################## 

record(ai, "$(P,recursive):CLB:PMATCH_STATE:RBV") {
  field(SCAN, "I/O Intr")
  field(PINI, "NO")
  field(DTYP, "asynFloat64")
  field(INP, "@asyn($(PITCHPORT,undefined),0)PMAC_VDM_P$(PMATCHPLC,undefined)00")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(EGU, "")
}

record(calcout, "$(P,recursive):CLB:PMATCH_STATE:SYNC") {
  field(DESC, "sync demand with readback")
  field(CALC, "A")
  field(OUT, "$(P,recursive):CLB:PMATCH_STATE PP")
  field(INPA, "$(P,recursive):CLB:PMATCH_STATE:RBV")
}

# % archiver 1 monitor
record(ao, "$(P,recursive):CLB:PMATCH_STATE") {
  field(DESC, "demand")
  field(EGU, "")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(OUT, "$(P,recursive):CLB:PMATCH_STATE:SET PP")
}

record(ao, "$(P,recursive):CLB:PMATCH_STATE:SET") {
  field(DESC, "Write value to pmac")
  field(DTYP, "asynFloat64")
  field(SDIS, "$(P,recursive):CLB:PMATCH_STATE:SYNC.PACT")
  field(OUT, "@asyn($(PITCHPORT,undefined),0)PMAC_WD_P$(PMATCHPLC,undefined)00")
}
##############################################################
#
# Template to write and read a variable on a PMAC/Geobrick.
#
##############################################################

# Macros
# % macro, __doc__, Simple template that reads and writes to a variable on a 
# PMAC or geoBrick via dynamic parameters.
# % macro, name, Object name and gui association name
# % macro, P, Pv Prefix
# % macro, Q, Pv Suffix
# % macro, DTYP, asyn DTYP (e.g., asynFloat64, asynInt32)
# % macro, PORT, Motor controller serial port
# % macro, TYPE, PMAC variable type (D=double, I=integer, H=hex, S=string)
# % macro, VAR, Variable on PMAC to write to, e.g. P700
# % macro, EGU, Engineering units
# % macro, VARIABLE_PREC, Variable Record precision
# % macro, LABEL, Label for GUI

# CSS GUI
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed_box.opi, P=$(P,recursive),Q=:CLB:PMATCH_DO,LABEL=$(LABEL,undefined), name=
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed.opi, P=$(P,recursive),Q=:CLB:PMATCH_DO,LABEL=$(LABEL,undefined), name=

# EGM GUI
# % gui, , edmembed, pmacVariableWrite.edl, P=$(P,recursive), Q=:CLB:PMATCH_DO, LABEL=$(LABEL,undefined)

##########################################
# Records for writing to PMAC variables
########################################## 

record(ai, "$(P,recursive):CLB:PMATCH_DO:RBV") {
  field(SCAN, "I/O Intr")
  field(PINI, "NO")
  field(DTYP, "asynFloat64")
  field(INP, "@asyn($(PITCHPORT,undefined),0)PMAC_VDM_P$(PMATCHPLC,undefined)01")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(EGU, "")
}

record(calcout, "$(P,recursive):CLB:PMATCH_DO:SYNC") {
  field(DESC, "sync demand with readback")
  field(CALC, "A")
  field(OUT, "$(P,recursive):CLB:PMATCH_DO PP")
  field(INPA, "$(P,recursive):CLB:PMATCH_DO:RBV")
}

# % archiver 1 monitor
record(ao, "$(P,recursive):CLB:PMATCH_DO") {
  field(DESC, "demand")
  field(EGU, "")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(OUT, "$(P,recursive):CLB:PMATCH_DO:SET PP")
}

record(ao, "$(P,recursive):CLB:PMATCH_DO:SET") {
  field(DESC, "Write value to pmac")
  field(DTYP, "asynFloat64")
  field(SDIS, "$(P,recursive):CLB:PMATCH_DO:SYNC.PACT")
  field(OUT, "@asyn($(PITCHPORT,undefined),0)PMAC_WD_P$(PMATCHPLC,undefined)01")
}
