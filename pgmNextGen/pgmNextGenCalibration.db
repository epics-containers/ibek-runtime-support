  field(DESC, "Disable proc once done")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):CLB:MIR:M3:CALCSEL")
  field(VAL, "1")
  field(OUT, "$(P,recursive):CLB:MIR:M3:SETINPUT1.DISA")
}

