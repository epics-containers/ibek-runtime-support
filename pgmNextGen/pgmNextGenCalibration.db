# This makes the component icon reflect the status and severity
# % gui, , sevr
# List of names for selection by user.
# Severity is returned via DISA.
# DISV set to 2 to stop disabling.
# % autosave 0 VAL
# % autosave 2 ZRST ONST TWST THST FRST FVST SXST SVST EIST NIST TEST ELST TVST TTST FTST FFST
# % gdatag,template,positioner,,Mirror  Calib Grating Selector
# % gdatag,mbbinary,rw,,SELECT,Position Selection
record(mbbo, "$(P,recursive):CLB:MIR:GSEL:SELECT") {
  field(DESC, "Mirror  Calib Grating Selector")
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZRST, "$(GLABA=$(GSTRA,undefined) lines/mm)")
  field(ONST, "$(GLABB=$(GSTRB,undefined) lines/mm)")
  field(TWST, "$(GLABC=$(GSTRC,undefined) lines/mm)")
  field(THST, "$(GLABD=$(GSTRD,undefined) lines/mm)")
  field(FRST, "$(GLABE=$(GSTRE,undefined) lines/mm)")
  field(FVST, "")
  field(SXST, "")
  field(FLNK, "$(P,recursive):CLB:MIR:GSEL:START PP MS")
  field(SVST, "")
  field(EIST, "")
  field(NIST, "")
  field(TEST, "")
  field(ELST, "")
  field(PINI, "YES")
  field(DISV, "2")
  field(VAL, "0")
  field(TVST, "")
  field(TTST, "")
  field(FTST, "")
  field(FFST, "")
}

# Open a gate on each positioner.
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):CLB:MIR:GSEL:SFANOUT") {
  field(DESC, "Fanout start motion")
  field(SELM, "All")
  field(VAL, "0")
}

# On selection make sure all gates are open before motion
record(fanout, "$(P,recursive):CLB:MIR:GSEL:FANOUT") {
  field(LNK1, "$(P,recursive):CLB:MIR:GSEL:SFANOUT PP MS")
  field(LNK2, "$(P,recursive):CLB:MIR:GSEL:DFANOUTA PP MS")
  field(DESC, "Fanout of processing")
}

# This PV is a good indication of severity
# % gui, , sevr
# Combined done moving indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
# % gdatag,pv,ro,,DMOV,Done Moving Indicator
record(calcout, "$(P,recursive):CLB:MIR:GSEL:DMOV") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Positioner done moving")
  field(OUT, "$(P,recursive):CLB:MIR:GSEL:BUSY CA")
  field(OOPT, "Every Time")
  field(DOPT, "Use OCAL")
  field(OCAL, "(A&B&C&D&E&F&G&H)?0:1")
}

# Test opening of gates by waiting between open gate and move commands
# To use this change the FLNK of VALUE to point to this.
record(seq, "$(P,recursive):CLB:MIR:GSEL:FANOUT2") {
  field(DESC, "Wait before sending val")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "0")
  field(LNK1, "$(P,recursive):CLB:MIR:GSEL:SFANOUT.PROC PP MS")
  field(DLY2, "5")
  field(LNK2, "$(P,recursive):CLB:MIR:GSEL:DFANOUTA.PROC PP MS")
}

#% gdatag,pv,ro,,ERROR,Error Indicator,<pv>.K
record(transform, "$(P,recursive):CLB:MIR:GSEL:ERROR") {
  field(DESC, "Errors from positioners")
  field(FLNK, "$(P,recursive):CLB:MIR:GSEL:SETERROR1 PP MS")
  field(CLCI, "MAX(MAX(A,B),MAX(C,D))")
  field(CLCJ, "MAX(MAX(E,F),MAX(G,H))")
  field(CLCK, "MAX(I,J)")
  field(INPA, "0")
  field(INPB, "0")
  field(INPC, "0")
  field(INPD, "0")
  field(INPE, "0")
  field(INPF, "0")
  field(INPG, "0")
  field(INPH, "0")
}

# Check if value has changed from previous call.
# This stops infinite loops when passing MS back
record(calcout, "$(P,recursive):CLB:MIR:GSEL:GATE") {
  field(DESC, "Stop repeated output")
  field(DTYP, "Soft Channel")
  field(CALC, "(A#B)||((~C)&D)")
  field(INPA, "$(P,recursive):CLB:MIR:GSEL:SELECT NPP MS")
  field(INPB, "$(P,recursive):CLB:MIR:GSEL:VALUE")
  field(OUT, "$(P,recursive):CLB:MIR:GSEL:VALUE PP MS")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
  field(INPC, "$(P,recursive):CLB:MIR:GSEL:INPOS")
  field(INPD, "$(P,recursive):CLB:MIR:GSEL:DMOV")
}

# Stores last selected value. This enables the gate record to check if the value has changed.
# Initially set to -1 to ensure first value is selected correctly.
record(longout, "$(P,recursive):CLB:MIR:GSEL:VALUE") {
  field(DESC, "Value selected")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):CLB:MIR:GSEL:FANOUT")
  field(VAL, "-1")
}

# Add 1 to selection to allow 1st seq to work
record(calc, "$(P,recursive):CLB:MIR:GSEL:SELECT1") {
  field(DESC, "Selection+1")
  field(CALC, "A+1")
  field(INPA, "$(P,recursive):CLB:MIR:GSEL:SELECT.VAL")
}

# Sets error severities for 2nd 6 positions
record(seq, "$(P,recursive):CLB:MIR:GSEL:SETERROR2") {
  field(DESC, "Sets errors in SELECT")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):CLB:MIR:GSEL:SELECT2.VAL PP")
  field(DOL1, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):CLB:MIR:GSEL:SELECT.EISV PP MS")
  field(DOL2, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):CLB:MIR:GSEL:SELECT.NISV PP MS")
  field(DOL3, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):CLB:MIR:GSEL:SELECT.TESV PP MS")
  field(DOL4, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):CLB:MIR:GSEL:SELECT.ELSV PP MS")
  field(DOL5, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):CLB:MIR:GSEL:SELECT.TVSV PP MS")
  field(DOL6, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):CLB:MIR:GSEL:SELECT.TTSV PP MS")
  field(DOL7, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):CLB:MIR:GSEL:SELECT.FTSV PP MS")
  field(DOL8, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):CLB:MIR:GSEL:SELECT.FFSV PP MS")
}

# Select the correct link from the second sequence
record(calc, "$(P,recursive):CLB:MIR:GSEL:SELECT2") {
  field(DESC, "Selection-7")
  field(CALC, "A-7")
  field(INPA, "$(P,recursive):CLB:MIR:GSEL:SELECT.VAL")
}

# Sets error severities for 1st 6 positions
record(seq, "$(P,recursive):CLB:MIR:GSEL:SETERROR1") {
  field(DESC, "Sets errors in SELECT")
  field(FLNK, "$(P,recursive):CLB:MIR:GSEL:SETERROR2")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):CLB:MIR:GSEL:SELECT1 PP")
  field(DOL1, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):CLB:MIR:GSEL:SELECT.ZRSV PP MS")
  field(DOL2, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):CLB:MIR:GSEL:SELECT.ONSV PP MS")
  field(DOL3, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):CLB:MIR:GSEL:SELECT.TWSV PP MS")
  field(DOL4, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):CLB:MIR:GSEL:SELECT.THSV PP MS")
  field(DOL5, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):CLB:MIR:GSEL:SELECT.FRSV PP MS")
  field(DOL6, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):CLB:MIR:GSEL:SELECT.FVSV PP MS")
  field(DOL7, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):CLB:MIR:GSEL:SELECT.SXSV PP MS")
  field(DOL8, "$(P,recursive):CLB:MIR:GSEL:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):CLB:MIR:GSEL:SELECT.SVSV PP MS")
}

# Stores types of underlying positioners
# 0 = Undefined
# 1 = Normal
# 2 = Motor
record(calcout, "$(P,recursive):CLB:MIR:GSEL:TYPE") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "0")
  field(B, "0")
  field(C, "0")
  field(D, "0")
  field(E, "0")
  field(F, "0")
  field(G, "0")
  field(H, "0")
  field(DESC, "Types of positioner")
}

# Record to allow EDM to process changes of strings.
record(bo, "$(P,recursive):CLB:MIR:GSEL:UPDATE") {
  field(DESC, "Dummy for EDM")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(VAL, "1")
  field(ZNAM, "Updating")
  field(ONAM, "Normal")
}

# Combined in position indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
#% gdatag,pv,ro,,INPOS,In Position Indicator
record(calcout, "$(P,recursive):CLB:MIR:GSEL:INPOS") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Combined in position monitor")
}

#% gdatag,pv,rw,,STOP,Stop Button,<pv>.PROC
record(dfanout, "$(P,recursive):CLB:MIR:GSEL:STOP") {
  field(DESC, "Stop all motors")
  field(VAL, "1")
  field(SELM, "All")
}

# This makes the component icon reflect the status
# % gui, , status
record(busy, "$(P,recursive):CLB:MIR:GSEL:BUSY") {
}

record(fanout, "$(P,recursive):CLB:MIR:GSEL:START") {
  field(LNK1, "$(P,recursive):CLB:MIR:GSEL:GATE PP MS")
  field(LNK2, "$(P,recursive):CLB:MIR:GSEL:BUSY")
  field(SDIS, "$(P,recursive):CLB:MIR:GSEL:ERRPROC PP")
}

# Fans selected position number to each separate controller
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):CLB:MIR:GSEL:DFANOUTA") {
  field(DESC, "Fanout selection")
  field(SELM, "All")
  field(DOL, "$(P,recursive):CLB:MIR:GSEL:VALUE.VAL")
  field(OMSL, "closed_loop")
}

record(calc, "$(P,recursive):CLB:MIR:GSEL:ERRPROC") {
  field(CALC, "A||B")
  field(INPA, "$(P,recursive):CLB:MIR:GSEL:SETERROR1.PACT")
  field(INPB, "$(P,recursive):CLB:MIR:GSEL:SETERROR2.PACT")
}

