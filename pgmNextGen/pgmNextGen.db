##############################################################
#
# Template to write and read a variable on a PMAC/Geobrick.
#
##############################################################

# Macros
# % macro, __doc__, Simple template that reads and writes to a variable on a 
# PMAC or geoBrick via dynamic parameters.
# % macro, name, Object name and gui association name
# % macro, P, Pv Prefix
# % macro, Q, Pv Suffix
# % macro, DTYP, asyn DTYP (e.g., asynFloat64, asynInt32)
# % macro, PORT, Motor controller serial port
# % macro, TYPE, PMAC variable type (D=double, I=integer, H=hex, S=string)
# % macro, VAR, Variable on PMAC to write to, e.g. P700
# % macro, EGU, Engineering units
# % macro, VARIABLE_PREC, Variable Record precision
# % macro, LABEL, Label for GUI

# CSS GUI
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed_box.opi, P=$(P,recursive),Q=:LINES,LABEL=$(LABEL,undefined), name=
# % gui, , boyembed, pmacApp_opi/pmac_variable_write_embed.opi, P=$(P,recursive),Q=:LINES,LABEL=$(LABEL,undefined), name=

# EGM GUI
# % gui, , edmembed, pmacVariableWrite.edl, P=$(P,recursive), Q=:LINES, LABEL=$(LABEL,undefined)

##########################################
# Records for writing to PMAC variables
########################################## 

record(ai, "$(P,recursive):LINES:RBV") {
  field(SCAN, "I/O Intr")
  field(PINI, "NO")
  field(DTYP, "asynFloat64")
  field(INP, "@asyn($(PITCH_PORT,undefined),0)PMAC_VDM_&$(COORD_NUM,undefined)Q21")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(EGU, "")
}

record(calcout, "$(P,recursive):LINES:SYNC") {
  field(DESC, "sync demand with readback")
  field(CALC, "A")
  field(OUT, "$(P,recursive):LINES PP")
  field(INPA, "$(P,recursive):LINES:RBV")
}

# % archiver 1 monitor
record(ao, "$(P,recursive):LINES") {
  field(DESC, "demand")
  field(EGU, "")
  field(PREC, "$(VARIABLE_PREC,undefined)")
  field(OUT, "$(P,recursive):LINES:SET PP")
}

record(ao, "$(P,recursive):LINES:SET") {
  field(DESC, "Write value to pmac")
  field(DTYP, "asynFloat64")
  field(SDIS, "$(P,recursive):LINES:SYNC.PACT")
  field(OUT, "@asyn($(PITCH_PORT,undefined),0)PMAC_WD_&$(COORD_NUM,undefined)Q21")
}
