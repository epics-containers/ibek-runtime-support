  field(DESC, "Disable proc once done")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):GRATINGPOS:CALCSEL")
  field(VAL, "1")
  field(OUT, "$(P,recursive):GRATINGPOS:SETINPUT1.DISA")
}

