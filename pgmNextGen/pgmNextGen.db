# File AutoDecouple.template
#
# % macro, __doc__, AutoDecouple template from the pgmNextGen module, supporting Plane Grating Monochromators (PGMs).  They have cross-dependency between the translation and pitch motors and require extra reverse move for both mirror and grating after translation motion to free the pitch motion called decoupling (or unlatching).
# % macro, P,                   Mandatory. Device prefix for the PGM.
# % macro, DECOUPLING_DISTANCE, Mandatory. Size of extra move to achieve decoupling/unlatching.
# % macro, REAL_MOTOR,          Mandatory. Name of the real translation motor.
# % macro, SOFT_MOTOR,          Mandatory. Name of soft motor presented to user to demand translation.
# % macro, DESC,                Mandatory. Description for the DESC field on the soft motor record.
# % macro, POST_DECOUPLE_DELAY  Optional.  Defaults to zero.  Delay in seconds to allow for disengaged couple (latch) switch signal to cause pitch motor record status to get updated.
#
# Work out which direction the motor has been commanded in
record(calcout, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):CHECK_DIRECTION") {
  field(DESC, "Find Direction")
  field(CALC, "A>B?1:-1")
  field(INPA, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined)")
  field(INPB, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined).RBV")
}

# Initial move with extra move in same direction
# Additional distance is decoupling distance
record(calcout, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):INITIALMOVE") {
  field(DESC, "Initial Move")
  field(CALC, "(B+(A*C))")
  field(INPA, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):CHECK_DIRECTION")
  field(INPB, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined)")
  field(INPC, "$(GRAT_DECOUPLE_DIST,undefined)")
}

# Final move back to the demanded position
# to complete the decouple move
record(calcout, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):FINALMOVE") {
  field(DESC, "Final Move")
  field(CALC, "(A-(B*C))")
  field(INPA, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):INITIALMOVE")
  field(INPB, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):CHECK_DIRECTION")
  field(INPC, "$(GRAT_DECOUPLE_DIST,undefined)")
}

# Busy record for soft motor done moving
record(busy, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):DONE") {
}

# Sequence of moves to be carried out
# Waits for each move to finish before continuing
# 
# Sets soft motor done move to Moving
# Moves to position decoupling distance further than demand
# Moves to demanded position to cause decouple
# Waits for POST_DECOUPLE_DELAY (while pitch motor status updates)
# Sets soft motor done move to Done
record(sseq, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):MOVE_SEQ") {
  field(WAIT1, "NoWait")
  field(DOL1, "0")
  field(LNK1, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):DONE CA")
  field(WAIT2, "Wait")
  field(DOL2, "1")
  field(LNK2, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):CHECK_DIRECTION.PROC CA")
  field(WAIT3, "Wait")
  field(DOL3, "1")
  field(LNK3, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):INITIALMOVE.PROC CA")
  field(WAIT4, "Wait")
  field(DOL4, "1")
  field(LNK4, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):FINALMOVE.PROC CA")
  field(WAIT5, "Wait")
  field(DOL5, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):INITIALMOVE")
  field(LNK5, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined) CA")
  field(WAIT6, "Wait")
  field(DOL6, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):FINALMOVE")
  field(LNK6, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined) CA")
  field(DOL7, "1")
  field(LNK7, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):DONE CA")
  field(SELM, "Mask")
  field(SELL, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):IFMOVE")
  field(DLY8, "$(POST_DECOUPLE_DELAY=0)")
  field(DOL8, "1")
  field(LNK8, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):DONE CA")
}

# Soft motor presented to the user
# When demand position entered it triggers
# sseq record to run through a series of moves
# % autosave 0 RDBD
record(motor, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined)") {
  field(DTYP, "Soft Channel")
  field(DIR, "Pos")
  field(VELO, "1")
  field(VBAS, "0")
  field(VMAX, "1")
  field(BDST, "0")
  field(BVEL, "0")
  field(BACC, "0")
  field(MRES, "0.001")
  field(RDBD, "0.001")
  field(RRES, "1")
  field(URIP, "Yes")
  field(PREC, "4")
  field(EGU, "mm")
  field(HHSV, "MINOR")
  field(LLSV, "MINOR")
  field(DESC, "Grating Translation")
  field(RDBL, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined).RBV")
  field(RTRY, "0")
  field(DINP, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):DONE")
  field(NTM, "NO")
  field(OUT, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):IFMOVE.PROC PP")
}

record(calcout, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined):IFMOVE") {
  field(DESC, "decide if move required")
  field(CALC, "((ABS(A-B)>=C)||(C=0.001))?191:79")
  field(INPA, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined)")
  field(INPB, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined).RBV")
  field(INPC, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined).RDBD")
  field(FLNK, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):MOVE_SEQ")
}

record(ao, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):GET:DHLM") {
  field(DESC, "Get motor dial high limit")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(DOL, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined).DHLM CPP")
  field(OMSL, "closed_loop")
  field(OUT, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined).DHLM")
  field(SCAN, "Passive")
}

record(ao, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined):GET:DLLM") {
  field(DESC, "Get motor dial low limit")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(DOL, "$(P,recursive):$(GRATING_TRANS_REAL_MOTOR,undefined).DLLM CPP")
  field(OMSL, "closed_loop")
  field(OUT, "$(P,recursive):$(GRATING_TRANS_SOFT_MOTOR,undefined).DLLM")
