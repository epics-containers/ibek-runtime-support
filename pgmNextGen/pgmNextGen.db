# This makes the component icon reflect the status and severity
# % gui, , sevr
# List of names for selection by user.
# Severity is returned via DISA.
# DISV set to 2 to stop disabling.
# % autosave 0 VAL
# % autosave 2 ZRST ONST TWST THST FRST FVST SXST SVST EIST NIST TEST ELST TVST TTST FTST FFST
# % gdatag,template,positioner,PGM.MIRRORSELECT,Mirror Selection
# % gdatag,mbbinary,rw,PGM.MIRRORSELECT,SELECT,Position Selection
record(mbbo, "$(P,recursive):MIRRORSELECT:SELECT") {
  field(DESC, "Mirror Positioner")
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZRST, "$(MSTRA,undefined)")
  field(ONST, "$(MSTRB,undefined)")
  field(TWST, "$(MSTRC,undefined)")
  field(THST, "$(MSTRD,undefined)")
  field(FRST, "$(MSTRE,undefined)")
  field(FVST, "")
  field(SXST, "")
  field(FLNK, "$(P,recursive):MIRRORSELECT:START PP MS")
  field(SVST, "")
  field(EIST, "")
  field(NIST, "")
  field(TEST, "")
  field(ELST, "")
  field(PINI, "YES")
  field(DISV, "2")
  field(VAL, "0")
  field(TVST, "")
  field(TTST, "")
  field(FTST, "")
  field(FFST, "")
}

# Open a gate on each positioner.
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):MIRRORSELECT:SFANOUT") {
  field(DESC, "Fanout start motion")
  field(SELM, "All")
  field(VAL, "0")
}

# On selection make sure all gates are open before motion
record(fanout, "$(P,recursive):MIRRORSELECT:FANOUT") {
  field(LNK1, "$(P,recursive):MIRRORSELECT:SFANOUT PP MS")
  field(LNK2, "$(P,recursive):MIRRORSELECT:DFANOUTA PP MS")
  field(DESC, "Fanout of processing")
}

# This PV is a good indication of severity
# % gui, , sevr
# Combined done moving indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
# % gdatag,pv,ro,PGM.MIRRORSELECT,DMOV,Done Moving Indicator
record(calcout, "$(P,recursive):MIRRORSELECT:DMOV") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Positioner done moving")
  field(OUT, "$(P,recursive):MIRRORSELECT:BUSY CA")
  field(OOPT, "Every Time")
  field(DOPT, "Use OCAL")
  field(OCAL, "(A&B&C&D&E&F&G&H)?0:1")
}

# Test opening of gates by waiting between open gate and move commands
# To use this change the FLNK of VALUE to point to this.
record(seq, "$(P,recursive):MIRRORSELECT:FANOUT2") {
  field(DESC, "Wait before sending val")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "0")
  field(LNK1, "$(P,recursive):MIRRORSELECT:SFANOUT.PROC PP MS")
  field(DLY2, "5")
  field(LNK2, "$(P,recursive):MIRRORSELECT:DFANOUTA.PROC PP MS")
}

#% gdatag,pv,ro,PGM.MIRRORSELECT,ERROR,Error Indicator,<pv>.K
record(transform, "$(P,recursive):MIRRORSELECT:ERROR") {
  field(DESC, "Errors from positioners")
  field(FLNK, "$(P,recursive):MIRRORSELECT:SETERROR1 PP MS")
  field(CLCI, "MAX(MAX(A,B),MAX(C,D))")
  field(CLCJ, "MAX(MAX(E,F),MAX(G,H))")
  field(CLCK, "MAX(I,J)")
  field(INPA, "0")
  field(INPB, "0")
  field(INPC, "0")
  field(INPD, "0")
  field(INPE, "0")
  field(INPF, "0")
  field(INPG, "0")
  field(INPH, "0")
}

# Check if value has changed from previous call.
# This stops infinite loops when passing MS back
record(calcout, "$(P,recursive):MIRRORSELECT:GATE") {
  field(DESC, "Stop repeated output")
  field(DTYP, "Soft Channel")
  field(CALC, "(A#B)||((~C)&D)")
  field(INPA, "$(P,recursive):MIRRORSELECT:SELECT NPP MS")
  field(INPB, "$(P,recursive):MIRRORSELECT:VALUE")
  field(OUT, "$(P,recursive):MIRRORSELECT:VALUE PP MS")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
  field(INPC, "$(P,recursive):MIRRORSELECT:INPOS")
  field(INPD, "$(P,recursive):MIRRORSELECT:DMOV")
}

# Stores last selected value. This enables the gate record to check if the value has changed.
# Initially set to -1 to ensure first value is selected correctly.
record(longout, "$(P,recursive):MIRRORSELECT:VALUE") {
  field(DESC, "Value selected")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):MIRRORSELECT:FANOUT")
  field(VAL, "-1")
}

# Add 1 to selection to allow 1st seq to work
record(calc, "$(P,recursive):MIRRORSELECT:SELECT1") {
  field(DESC, "Selection+1")
  field(CALC, "A+1")
  field(INPA, "$(P,recursive):MIRRORSELECT:SELECT.VAL")
}

# Sets error severities for 2nd 6 positions
record(seq, "$(P,recursive):MIRRORSELECT:SETERROR2") {
  field(DESC, "Sets errors in SELECT")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):MIRRORSELECT:SELECT2.VAL PP")
  field(DOL1, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):MIRRORSELECT:SELECT.EISV PP MS")
  field(DOL2, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):MIRRORSELECT:SELECT.NISV PP MS")
  field(DOL3, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):MIRRORSELECT:SELECT.TESV PP MS")
  field(DOL4, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):MIRRORSELECT:SELECT.ELSV PP MS")
  field(DOL5, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):MIRRORSELECT:SELECT.TVSV PP MS")
  field(DOL6, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):MIRRORSELECT:SELECT.TTSV PP MS")
  field(DOL7, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):MIRRORSELECT:SELECT.FTSV PP MS")
  field(DOL8, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):MIRRORSELECT:SELECT.FFSV PP MS")
}

# Select the correct link from the second sequence
record(calc, "$(P,recursive):MIRRORSELECT:SELECT2") {
  field(DESC, "Selection-7")
  field(CALC, "A-7")
  field(INPA, "$(P,recursive):MIRRORSELECT:SELECT.VAL")
}

# Sets error severities for 1st 6 positions
record(seq, "$(P,recursive):MIRRORSELECT:SETERROR1") {
  field(DESC, "Sets errors in SELECT")
  field(FLNK, "$(P,recursive):MIRRORSELECT:SETERROR2")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):MIRRORSELECT:SELECT1 PP")
  field(DOL1, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):MIRRORSELECT:SELECT.ZRSV PP MS")
  field(DOL2, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):MIRRORSELECT:SELECT.ONSV PP MS")
  field(DOL3, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):MIRRORSELECT:SELECT.TWSV PP MS")
  field(DOL4, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):MIRRORSELECT:SELECT.THSV PP MS")
  field(DOL5, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):MIRRORSELECT:SELECT.FRSV PP MS")
  field(DOL6, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):MIRRORSELECT:SELECT.FVSV PP MS")
  field(DOL7, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):MIRRORSELECT:SELECT.SXSV PP MS")
  field(DOL8, "$(P,recursive):MIRRORSELECT:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):MIRRORSELECT:SELECT.SVSV PP MS")
}

# Stores types of underlying positioners
# 0 = Undefined
# 1 = Normal
# 2 = Motor
record(calcout, "$(P,recursive):MIRRORSELECT:TYPE") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "0")
  field(B, "0")
  field(C, "0")
  field(D, "0")
  field(E, "0")
  field(F, "0")
  field(G, "0")
  field(H, "0")
  field(DESC, "Types of positioner")
}

# Record to allow EDM to process changes of strings.
record(bo, "$(P,recursive):MIRRORSELECT:UPDATE") {
  field(DESC, "Dummy for EDM")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(VAL, "1")
  field(ZNAM, "Updating")
  field(ONAM, "Normal")
}

# Combined in position indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
#% gdatag,pv,ro,PGM.MIRRORSELECT,INPOS,In Position Indicator
record(calcout, "$(P,recursive):MIRRORSELECT:INPOS") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Combined in position monitor")
}

#% gdatag,pv,rw,PGM.MIRRORSELECT,STOP,Stop Button,<pv>.PROC
record(dfanout, "$(P,recursive):MIRRORSELECT:STOP") {
  field(DESC, "Stop all motors")
  field(VAL, "1")
  field(SELM, "All")
}

# This makes the component icon reflect the status
# % gui, , status
record(busy, "$(P,recursive):MIRRORSELECT:BUSY") {
}

record(fanout, "$(P,recursive):MIRRORSELECT:START") {
  field(LNK1, "$(P,recursive):MIRRORSELECT:GATE PP MS")
  field(LNK2, "$(P,recursive):MIRRORSELECT:BUSY")
  field(SDIS, "$(P,recursive):MIRRORSELECT:ERRPROC PP")
}

# Fans selected position number to each separate controller
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):MIRRORSELECT:DFANOUTA") {
  field(DESC, "Fanout selection")
  field(SELM, "All")
  field(DOL, "$(P,recursive):MIRRORSELECT:VALUE.VAL")
  field(OMSL, "closed_loop")
}

record(calc, "$(P,recursive):MIRRORSELECT:ERRPROC") {
  field(CALC, "A||B")
  field(INPA, "$(P,recursive):MIRRORSELECT:SETERROR1.PACT")
  field(INPB, "$(P,recursive):MIRRORSELECT:SETERROR2.PACT")
}

# short strings to display on positioner value buttons
# on -2pos, -3pos and -6pos embedded screens
record(stringout, "$(P,recursive):MIRRORSELECT:P1VALS") {
  field(DESC, "short label for P1 VALS")
  field(VAL, "P1 Val")
}

record(stringout, "$(P,recursive):MIRRORSELECT:P2VALS") {
  field(DESC, "short label for P2 VALS")
  field(VAL, "P2 Val")
}

record(stringout, "$(P,recursive):MIRRORSELECT:P3VALS") {
  field(DESC, "short label for P3 VALS")
  field(VAL, "P3 Val")
}

record(stringout, "$(P,recursive):MIRRORSELECT:P4VALS") {
  field(DESC, "short label for P4 VALS")
  field(VAL, "P4 Val")
}

record(stringout, "$(P,recursive):MIRRORSELECT:P5VALS") {
  field(DESC, "short label for P5 VALS")
  field(VAL, "P5 Val")
}

record(stringout, "$(P,recursive):MIRRORSELECT:P6VALS") {
  field(DESC, "short label for P6 VALS")
  field(VAL, "P6 Val")
}
#! Generated by VisualDCT v2.7.1-SNAPSHOT

record(stringout, "$(P,recursive):GRATLINE:SETINPUT2") {
  field(DESC, "Create open gate link")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):GRATLINE:SETINPUT3")
  field(VAL, "$(P,recursive):GRATLINE:OPENGATE PP")
  field(OUT, "$(P,recursive):GRATINGSELECT:SFANOUT.OUTA CA")
}

# This record stops the setting of the input after 1 cycle
# It also causes the multipositioner's fanout record to be processed.
# This pushes the current value to the motor.
record(bo, "$(P,recursive):GRATLINE:SETUPDISABLE") {
