  field(EGU, "mm")
}

record(calcout, "$(P,recursive):MIRRORPOS:SELCALC1") {
  field(FLNK, "$(P,recursive):MIRRORPOS:SELCALC2")
  field(CALC, "A<12?1:0")
  field(INPA, "$(P,recursive):MIRRORPOS:SEL.VAL")
  field(OUT, "$(P,recursive):MIRRORPOS:SEL1.SELN PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
}

record(calcout, "$(P,recursive):MIRRORPOS:SELCALC2") {
  field(CALC, "A>=12?1:0")
  field(INPA, "$(P,recursive):MIRRORPOS:SEL")
  field(OUT, "$(P,recursive):MIRRORPOS:SEL2.SELN PP")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A-12")
}

# This record contains the list of positions for motor.
# The multipositioner writes to the VAL field to select one.
record(longout, "$(P,recursive):MIRRORPOS:SEL") {
  field(DESC, "Mirror Position")
  field(FLNK, "$(P,recursive):MIRRORPOS:SELCALC1")
}

record(ao, "$(P,recursive):MIRRORPOS:SEL1COPY") {
  field(DOL, "$(P,recursive):MIRRORPOS:SEL1.VAL")
  field(OMSL, "closed_loop")
  field(PREC, "5")
  field(OUT, "$(P,recursive):MIRRORPOS:SETVALUE PP")
  field(EGU, "mm")
}

