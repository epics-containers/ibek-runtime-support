# This makes the component icon reflect the status and severity
# % gui, , sevr
# List of names for selection by user.
# Severity is returned via DISA.
# DISV set to 2 to stop disabling.
# % autosave 0 VAL
# % autosave 2 ZRST ONST TWST THST FRST FVST SXST SVST EIST NIST TEST ELST TVST TTST FTST FFST
# % gdatag,template,positioner,PGM.GRATINGSELECT,Grating Selection
# % gdatag,mbbinary,rw,PGM.GRATINGSELECT,SELECT,Position Selection
record(mbbo, "$(P,recursive):GRATINGSELECT:SELECT") {
  field(DESC, "Grating Positioner")
  field(SCAN, "Passive")
  field(DTYP, "Soft Channel")
  field(ZRST, "$(GLABA=$(GSTRA,undefined) lines/mm)")
  field(ONST, "$(GLABB=$(GSTRB,undefined) lines/mm)")
  field(TWST, "$(GLABC=$(GSTRC,undefined) lines/mm)")
  field(THST, "$(GLABD=$(GSTRD,undefined) lines/mm)")
  field(FRST, "$(GLABE=$(GSTRE,undefined) lines/mm)")
  field(FVST, "")
  field(SXST, "")
  field(FLNK, "$(P,recursive):GRATINGSELECT:START PP MS")
  field(SVST, "")
  field(EIST, "")
  field(NIST, "")
  field(TEST, "")
  field(ELST, "")
  field(PINI, "YES")
  field(DISV, "2")
  field(VAL, "0")
  field(TVST, "")
  field(TTST, "")
  field(FTST, "")
  field(FFST, "")
}

# Open a gate on each positioner.
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):GRATINGSELECT:SFANOUT") {
  field(DESC, "Fanout start motion")
  field(SELM, "All")
  field(VAL, "0")
}

# On selection make sure all gates are open before motion
record(fanout, "$(P,recursive):GRATINGSELECT:FANOUT") {
  field(LNK1, "$(P,recursive):GRATINGSELECT:SFANOUT PP MS")
  field(LNK2, "$(P,recursive):GRATINGSELECT:DFANOUTA PP MS")
  field(DESC, "Fanout of processing")
}

# This PV is a good indication of severity
# % gui, , sevr
# Combined done moving indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
# % gdatag,pv,ro,PGM.GRATINGSELECT,DMOV,Done Moving Indicator
record(calcout, "$(P,recursive):GRATINGSELECT:DMOV") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Positioner done moving")
  field(OUT, "$(P,recursive):GRATINGSELECT:BUSY CA")
  field(OOPT, "Every Time")
  field(DOPT, "Use OCAL")
  field(OCAL, "(A&B&C&D&E&F&G&H)?0:1")
}

# Test opening of gates by waiting between open gate and move commands
# To use this change the FLNK of VALUE to point to this.
record(seq, "$(P,recursive):GRATINGSELECT:FANOUT2") {
  field(DESC, "Wait before sending val")
  field(SCAN, "Passive")
  field(SELM, "All")
  field(DOL1, "0")
  field(LNK1, "$(P,recursive):GRATINGSELECT:SFANOUT.PROC PP MS")
  field(DLY2, "5")
  field(LNK2, "$(P,recursive):GRATINGSELECT:DFANOUTA.PROC PP MS")
}

#% gdatag,pv,ro,PGM.GRATINGSELECT,ERROR,Error Indicator,<pv>.K
record(transform, "$(P,recursive):GRATINGSELECT:ERROR") {
  field(DESC, "Errors from positioners")
  field(FLNK, "$(P,recursive):GRATINGSELECT:SETERROR1 PP MS")
  field(CLCI, "MAX(MAX(A,B),MAX(C,D))")
  field(CLCJ, "MAX(MAX(E,F),MAX(G,H))")
  field(CLCK, "MAX(I,J)")
  field(INPA, "0")
  field(INPB, "0")
  field(INPC, "0")
  field(INPD, "0")
  field(INPE, "0")
  field(INPF, "0")
  field(INPG, "0")
  field(INPH, "0")
}

# Check if value has changed from previous call.
# This stops infinite loops when passing MS back
record(calcout, "$(P,recursive):GRATINGSELECT:GATE") {
  field(DESC, "Stop repeated output")
  field(DTYP, "Soft Channel")
  field(CALC, "(A#B)||((~C)&D)")
  field(INPA, "$(P,recursive):GRATINGSELECT:SELECT NPP MS")
  field(INPB, "$(P,recursive):GRATINGSELECT:VALUE")
  field(OUT, "$(P,recursive):GRATINGSELECT:VALUE PP MS")
  field(OOPT, "When Non-zero")
  field(DOPT, "Use OCAL")
  field(OCAL, "A")
  field(INPC, "$(P,recursive):GRATINGSELECT:INPOS")
  field(INPD, "$(P,recursive):GRATINGSELECT:DMOV")
}

# Stores last selected value. This enables the gate record to check if the value has changed.
# Initially set to -1 to ensure first value is selected correctly.
record(longout, "$(P,recursive):GRATINGSELECT:VALUE") {
  field(DESC, "Value selected")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):GRATINGSELECT:FANOUT")
  field(VAL, "-1")
}

# Add 1 to selection to allow 1st seq to work
record(calc, "$(P,recursive):GRATINGSELECT:SELECT1") {
  field(DESC, "Selection+1")
  field(CALC, "A+1")
  field(INPA, "$(P,recursive):GRATINGSELECT:SELECT.VAL")
}

# Sets error severities for 2nd 6 positions
record(seq, "$(P,recursive):GRATINGSELECT:SETERROR2") {
  field(DESC, "Sets errors in SELECT")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):GRATINGSELECT:SELECT2.VAL PP")
  field(DOL1, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):GRATINGSELECT:SELECT.EISV PP MS")
  field(DOL2, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):GRATINGSELECT:SELECT.NISV PP MS")
  field(DOL3, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):GRATINGSELECT:SELECT.TESV PP MS")
  field(DOL4, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):GRATINGSELECT:SELECT.ELSV PP MS")
  field(DOL5, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):GRATINGSELECT:SELECT.TVSV PP MS")
  field(DOL6, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):GRATINGSELECT:SELECT.TTSV PP MS")
  field(DOL7, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):GRATINGSELECT:SELECT.FTSV PP MS")
  field(DOL8, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):GRATINGSELECT:SELECT.FFSV PP MS")
}

# Select the correct link from the second sequence
record(calc, "$(P,recursive):GRATINGSELECT:SELECT2") {
  field(DESC, "Selection-7")
  field(CALC, "A-7")
  field(INPA, "$(P,recursive):GRATINGSELECT:SELECT.VAL")
}

# Sets error severities for 1st 6 positions
record(seq, "$(P,recursive):GRATINGSELECT:SETERROR1") {
  field(DESC, "Sets errors in SELECT")
  field(FLNK, "$(P,recursive):GRATINGSELECT:SETERROR2")
  field(SELM, "Specified")
  field(SELL, "$(P,recursive):GRATINGSELECT:SELECT1 PP")
  field(DOL1, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK1, "$(P,recursive):GRATINGSELECT:SELECT.ZRSV PP MS")
  field(DOL2, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK2, "$(P,recursive):GRATINGSELECT:SELECT.ONSV PP MS")
  field(DOL3, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK3, "$(P,recursive):GRATINGSELECT:SELECT.TWSV PP MS")
  field(DOL4, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK4, "$(P,recursive):GRATINGSELECT:SELECT.THSV PP MS")
  field(DOL5, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK5, "$(P,recursive):GRATINGSELECT:SELECT.FRSV PP MS")
  field(DOL6, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK6, "$(P,recursive):GRATINGSELECT:SELECT.FVSV PP MS")
  field(DOL7, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK7, "$(P,recursive):GRATINGSELECT:SELECT.SXSV PP MS")
  field(DOL8, "$(P,recursive):GRATINGSELECT:ERROR.K NPP MS")
  field(LNK8, "$(P,recursive):GRATINGSELECT:SELECT.SVSV PP MS")
}

# Stores types of underlying positioners
# 0 = Undefined
# 1 = Normal
# 2 = Motor
record(calcout, "$(P,recursive):GRATINGSELECT:TYPE") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "0")
  field(B, "0")
  field(C, "0")
  field(D, "0")
  field(E, "0")
  field(F, "0")
  field(G, "0")
  field(H, "0")
  field(DESC, "Types of positioner")
}

# Record to allow EDM to process changes of strings.
record(bo, "$(P,recursive):GRATINGSELECT:UPDATE") {
  field(DESC, "Dummy for EDM")
  field(PINI, "YES")
  field(DTYP, "Soft Channel")
  field(VAL, "1")
  field(ZNAM, "Updating")
  field(ONAM, "Normal")
}

# Combined in position indicator.
# Value from AND of all 8 possible inputs.
# The fixed values of 1 are overwritten by each positioner.
#% gdatag,pv,ro,PGM.GRATINGSELECT,INPOS,In Position Indicator
record(calcout, "$(P,recursive):GRATINGSELECT:INPOS") {
  field(CALC, "A&B&C&D&E&F&G&H")
  field(A, "1")
  field(B, "1")
  field(C, "1")
  field(D, "1")
  field(E, "1")
  field(F, "1")
  field(G, "1")
  field(H, "1")
  field(DESC, "Combined in position monitor")
}

#% gdatag,pv,rw,PGM.GRATINGSELECT,STOP,Stop Button,<pv>.PROC
record(dfanout, "$(P,recursive):GRATINGSELECT:STOP") {
  field(DESC, "Stop all motors")
  field(VAL, "1")
  field(SELM, "All")
}

# This makes the component icon reflect the status
# % gui, , status
record(busy, "$(P,recursive):GRATINGSELECT:BUSY") {
}

record(fanout, "$(P,recursive):GRATINGSELECT:START") {
  field(LNK1, "$(P,recursive):GRATINGSELECT:GATE PP MS")
  field(LNK2, "$(P,recursive):GRATINGSELECT:BUSY")
  field(SDIS, "$(P,recursive):GRATINGSELECT:ERRPROC PP")
}

# Fans selected position number to each separate controller
# The outlinks are filled by the positioners.
record(dfanout, "$(P,recursive):GRATINGSELECT:DFANOUTA") {
  field(DESC, "Fanout selection")
  field(SELM, "All")
  field(DOL, "$(P,recursive):GRATINGSELECT:VALUE.VAL")
  field(OMSL, "closed_loop")
}

record(calc, "$(P,recursive):GRATINGSELECT:ERRPROC") {
  field(CALC, "A||B")
  field(INPA, "$(P,recursive):GRATINGSELECT:SETERROR1.PACT")
  field(INPB, "$(P,recursive):GRATINGSELECT:SETERROR2.PACT")
}

# short strings to display on positioner value buttons
# on -2pos, -3pos and -6pos embedded screens
record(stringout, "$(P,recursive):GRATINGSELECT:P1VALS") {
  field(DESC, "short label for P1 VALS")
  field(VAL, "P1 Val")
}

