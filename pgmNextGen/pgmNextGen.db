}

record(transform, "$(P,recursive):MIRRORPOS:UPD") {
  field(CLCE, "A")
  field(CLCF, "ABS(D-B)<=C")
  field(INPA, "$(P,recursive):$(MIRROR_TRANS_SOFT_MOTOR,undefined).DMOV CP")
  field(INPB, "$(P,recursive):MIRRORPOS:SETVALUE")
  field(INPC, "$(P,recursive):$(MIRROR_TRANS_SOFT_MOTOR,undefined).RDBD")
  field(INPD, "$(P,recursive):$(MIRROR_TRANS_SOFT_MOTOR,undefined).RBV CP MS")
  field(OUTE, "$(P,recursive):MIRRORPOS:DMOV PP")
  field(OUTF, "$(P,recursive):MIRRORPOS:INPOS PP")
  field(EGU, "mm")
  field(PREC, "5")
}

record(stringout, "$(P,recursive):MIRRORPOS:SETINPUT5") {
  field(DESC, "Set stop link")
  field(DTYP, "Soft Channel")
  field(FLNK, "$(P,recursive):MIRRORPOS:SETUPDISABLE")
  field(VAL, "$(P,recursive):MIRRORPOS:STOP PP")
  field(OUT, "$(P,recursive):MIRRORSELECT:STOP.OUTA CA")
}

# Send stop to motor
record(bo, "$(P,recursive):MIRRORPOS:STOP") {
  field(DESC, "Stop motor")
  field(OMSL, "closed_loop")
  field(DOL, "1")
  field(OUT, "$(P,recursive):$(MIRROR_TRANS_SOFT_MOTOR,undefined).STOP PP")
}

