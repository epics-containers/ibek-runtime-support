# Template for BL05J end station to support the beam status widgets on the Nano-ES part of the synoptic.
# 
# Absorbers, shutters and diagnostic screens are usually included in the beam status calculations, but vacuum valve status is ignored
# (believe this is because the interlock system normally stops the beam hitting valves anyway).
# This template includes the status of the manual valves (readback) which are present on this low-energy beamline.
# 
# % macro, P, Device PV Prefix
# 
# 
# INPA field gets its data via link to the CROTCH record belonging to BL05I-VA-IOC-01.
# Processing arrives at this record from the BRANCH fanout in BL05I-VA-IOC-01.
record(calc, "$(P):CROTCH:STA") {
  field(CALC, "A=1")
  field(INPA, "BL05I-OP-BEAM-01:CROTCH:STA NPP MS")
  field(FLNK, "$(P):CROTCHTOSHTRJ1:STA.PROC")
}

record(calc, "$(P):CROTCHTOSHTRJ1:STA") {
  field(CALC, "A=1")
  field(INPA, "$(P):CROTCH:STA.VAL NPP MS")
  field(FLNK, "$(P):SHTRJ1TOGVJ2GVJ3:STA.PROC")
}

# Need to add the manual valves in here.
record(calc, "$(P):SHTRJ1TOGVJ2GVJ3:STA") {
  field(CALC, "A=1&B=1")
  field(INPA, "$(P):CROTCHTOSHTRJ1:STA.VAL NPP MS")
  field(INPB, "BL05J-PS-SHTR-01:STA NPP MS")
  field(FLNK, "$(P):GVJ2GVJ3TOGVJ4GVJ5:STA.PROC PP")
}

# Dj6 screen does not block the beam because it is mounted on slit blades.
# GVJ2, GVJ3 and GVJ4,GVJ5 are manual twin valves which seem to get hit by the beam.
record(calc, "$(P):GVJ2GVJ3TOGVJ4GVJ5:STA") {
  field(CALC, "A=1&B=1&C=1")
  field(INPA, "$(P):SHTRJ1TOGVJ2GVJ3:STA.VAL NPP MS")
  field(INPB, "BL05J-VA-VALVE-02:STA NPP MS")
  field(INPC, "BL05J-VA-VALVE-03:STA NPP MS")
  field(FLNK, "$(P):GVJ4GVJ5TOGVJ8:STA.PROC")
}

# Dj7 is the ion chamber and is not considered to block the beam (on other beamlines anyway).
# Dj8 might or might not exist.  Built without it for now.
# Dj9 does not block the beam because it has no screen.
# Assuming J-branch will be like the I-branch and have readonly valve on the end.
record(calc, "$(P):GVJ4GVJ5TOGVJ8:STA") {
  field(CALC, "A=1&B=1&C=1")
  field(INPA, "$(P):GVJ2GVJ3TOGVJ4GVJ5:STA.VAL NPP MS")
  field(INPB, "BL05J-VA-VALVE-04:STA NPP MS")
  field(INPC, "BL05J-VA-VALVE-05:STA NPP MS")
  field(FLNK, "$(P):GVJ8TOENDSTJ1:STA.PROC")
}

# Assuming GVJ8 is the last thing before the end station.
record(calc, "$(P):GVJ8TOENDSTJ1:STA") {
  field(CALC, "A=1&B=1")
  field(INPA, "$(P):GVJ4GVJ5TOGVJ8:STA.VAL NPP MS")
  field(INPB, "BL05J-VA-VALVE-08:STA NPP MS")
}

