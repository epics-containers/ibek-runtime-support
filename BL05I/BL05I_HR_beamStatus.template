# Template for BL05I end station to support the beam status widgets on the HR-ES part of the synoptic.
# 
# Absorbers, shutters and diagnostic screens are usually included in the beam status calculations, but vacuum valve status is ignored
# (believe this is because the interlock system normally stops the beam hitting valves anyway).
# This template includes the status of the manual valves (readback) which are present on this low-energy beamline.
# 
# % macro, P, Device PV Prefix
# 
# 
# INPA field gets its data via link to the CROTCH record belonging to BL05I-VA-IOC-01.
# Processing arrives at this record from the BRANCH fanout in BL05I-VA-IOC-01.
record(calc, "$(P):CROTCH:STA") {
  field(CALC, "A=1")
  field(INPA, "BL05I-OP-BEAM-01:CROTCH:STA NPP MS")
  field(FLNK, "$(P):CROTCHTOSHTR1:STA")
}

record(calc, "$(P):CROTCHTOSHTR1:STA") {
  field(CALC, "A=1")
  field(INPA, "$(P):CROTCH:STA.VAL NPP MS")
  field(FLNK, "$(P):SHTR1TOD5:STA")
}

record(calc, "$(P):SHTR1TOD5:STA") {
  field(CALC, "A=1&B=1")
  field(INPA, "$(P):CROTCHTOSHTR1:STA.VAL NPP MS")
  field(INPB, "BL05I-PS-SHTR-01:STA NPP MS")
  field(FLNK, "$(P):D5TOGV7GV8:STA")
}

# Di6 screen does not block the beam because it is mounted on slit blades.
# However the manual valves seem to get beam on them and presumably they block the beam
# so include those in the calculation.
record(calc, "$(P):D5TOGV7GV8:STA") {
  field(CALC, "A=1&B=3")
  field(INPA, "$(P):SHTR1TOD5:STA.VAL NPP MS")
  field(INPB, "BL05I-DI-PHDGN-05:STA NPP MS")
  field(FLNK, "$(P):GV7GV8TOGV9GV10:STA")
}

record(calc, "$(P):GV7GV8TOGV9GV10:STA") {
  field(CALC, "A=1&B=1&C=1")
  field(INPA, "$(P):D5TOGV7GV8:STA.VAL NPP MS")
  field(INPB, "BL05I-VA-VALVE-07:STA NPP MS")
  field(INPC, "BL05I-VA-VALVE-08:STA NPP MS")
  field(FLNK, "$(P):GV9GV10TOGV14:STA")
}

# Di9 does not have a screen.  GV14 is a manual valve, so could have beam placed on it.
record(calc, "$(P):GV9GV10TOGV14:STA") {
  field(CALC, "A=1&B=1&C=1")
  field(INPA, "$(P):GV7GV8TOGV9GV10:STA.VAL NPP MS")
  field(INPB, "BL05I-VA-VALVE-09:STA NPP MS")
  field(INPC, "BL05I-VA-VALVE-10:STA NPP MS")
  field(FLNK, "$(P):GV14TOENDST1:STA")
}

record(calc, "$(P):GV14TOENDST1:STA") {
  field(CALC, "A=1&B=1")
  field(INPA, "$(P):GV9GV10TOGV14:STA.VAL NPP MS")
  field(INPB, "BL05I-VA-VALVE-14:STA NPP MS")
}

