# This record takes the limit determined from the switch states and
# compares it with the one from exclusion zones and applies the more
# restrictive one.  In order to do this need to know what type of
# limit (high or low).  Use RVAL for the limit type since it seemed to
# end up with some garbage when you used val.
record(calcout, "$(P)$(R)") {
  field(DESC, "Combine limit from switches & positions")
  field(CALC, "(C-1)*A>(C-1)*B?D:5")
#  field(SCAN, "1 second")
  field(OUT, "$(P)$(MTRLIM)")
#  field(OUT, "$(P):SIM$(MTRLIM) PP")
  field(OOPT, "Every Time")
  field(DOPT, "Use OCAL")
  field(OCAL, "(C-1)*A>(C-1)*B?B:A")
  field(INPA, "$(P)$(R):SWITCHES.OVAL")
  field(INPB, "$(P)$(R):POSITIONS")
  field(INPC, "$(P)$(R):POSITIONS:LIMTYPE")
  field(INPD, "$(P)$(R):SWITCHES")
}

