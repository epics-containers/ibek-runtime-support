  field(ZRST, "On")
  field(ONST, "Off")
  field(TWST, "Reset")
  field(INP, "$(PLCNAME):V2:PID:SRAW:RBV MS")
}

# PID: End of records to provide meaningful state strings for the Valve PID States.
