# PID: End of records to control the Valve PID States (Enable/Disable automatic/manual) .
# -------------------------------------------------------------
# PID: END OF RECORDS TO READ, WRITE AND PROCESS PID ENABLE/DISABLE CONTROL.
#****************************************************************
# WPUV: START OF RECORDS FOR THE WATER TURBINE PUMP AND THE UV STERILISER.
# (The UV Steriliser is also referred to as the Bug Killer or the Bug Zapper.)
# -------------------------------------------------------------
# WPUV:  Records to read the water turbine pump and UV Steriliser status data block.
# First to read the current demand values.
# Read first 18  values from the DM memory from the PLC control crate.
# This is to allow for possible interlocks.
# These contain the pressures, flows and temperatures.  They will be split off in
# single value subarrays.
record(waveform, "$(PLCNAME):READ:WPUV") {
  field(DESC, "UVSteriliser, pump 0010-0028")
  field(DTYP, "stream")
  field(SCAN, "Passive")
  field(INP, "@Hostlink.proto readDMmulti(0010) $(port)")
  field(NELM, "18")
  field(FTVL, "SHORT")
  field(FLNK, "$(PLCNAME):FAN:WPUV.PROC PP")
}

# WPUV: End of records to read the UV Steriliser and water turbine pump status data block.
# -------------------------------------------------------------
# WPUV: Records to process the water turbine pump and UV Steriliser status data block.
# Fanout the processing for the raw Water Pump records and Bug killer.
record(fanout, "$(PLCNAME):FAN:WPUV") {
  field(DESC, "Propagate pump/Ster. status")
  field(LNK1, "$(PLCNAME):FAN:WP")
  field(LNK2, "$(PLCNAME):FAN:UV")
}

record(fanout, "$(PLCNAME):FAN:WP") {
  field(DESC, "Propagate water pump status")
  field(LNK1, "$(PLCNAME):TRBNP:SRAW:RBV")
  field(LNK2, "$(PLCNAME):TRBNP:ILKSTARAW:RBV")
  field(LNK3, "$(WPNAME=$(PLCNAME):TRBNP):ILKS:RBV")
}

record(fanout, "$(PLCNAME):FAN:UV") {
  field(DESC, "Propagate Steriliser status")
  field(LNK1, "$(PLCNAME):UVSTL:SRAW:RBV")
  field(LNK2, "$(PLCNAME):UVSTL:ILKSTARAW:RBV")
  field(LNK3, "$(UVNAME=$(PLCNAME):UVSTL):ILKS:RBV")
}

# -------------------------------------------------------------
# WPUV: Records containing raw state and interlock values.
#
# The single element slice of the WPUV data waveform representing water turbine pump state value.
record(subArray, "$(PLCNAME):TRBNP:SRAW:RBV") {
  field(DESC, "Raw Water Turbine Pump State")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(INDX, "3")
  field(FLNK, "$(WPNAME=$(PLCNAME):TRBNP):STATE:RBV.PROC")
}

# The single element slice of the WPUV data waveform representing water turbine pump overall interlock status value.
record(subArray, "$(PLCNAME):TRBNP:ILKSTARAW:RBV") {
  field(DESC, "Raw Pump Interlock Status")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(INDX, "2")
  field(FLNK, "$(WPNAME=$(PLCNAME):TRBNP):ILKSTA:RBV.PROC")
}

# The three element slice of the WPUV data waveform representing Water Pump interlock values (latched, initial and raw/current?).
# Each is a single value of 16 bits containing all the potential interlock levels.
# The rest of the records for interlocks are syphoned off into the WaterChillerInterlock template.
record(subArray, "$(WPNAME=$(PLCNAME):TRBNP):ILKS:RBV") {
  field(DESC, "$(WPDESC=$(PLCNAME) Pump) ILKs")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(NELM, "3")
  field(INDX, "5")
}

# The single element slice of the WPUV data waveform representing Bug killer status value.
# Grab the numeric value and forward on to provide meaningful state.
record(subArray, "$(PLCNAME):UVSTL:SRAW:RBV") {
  field(DESC, "Raw UV Steriliser State.")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(INDX, "13")
  field(FLNK, "$(UVNAME=$(PLCNAME):UVSTL):STATE:RBV.PROC")
}

# The single element slice of the WPUV data waveform representing water turbine pump overall interlock status value.
record(subArray, "$(PLCNAME):UVSTL:ILKSTARAW:RBV") {
  field(DESC, "Raw UV Steriliser ILK Status")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(INDX, "12")
  field(FLNK, "$(UVNAME=$(PLCNAME):UVSTL):ILKSTA:RBV.PROC")
}

# The three element slice of the WPUV data waveform representing UV Steriliser interlock values (latched, initial and raw/current?).
# Each is a single value of 16 bits containing all the potential interlock levels.
# The rest of the work for interlocks are syphoned off into the WaterChillerInterlock template.
record(subArray, "$(UVNAME=$(PLCNAME):UVSTL):ILKS:RBV") {
  field(DESC, "$(UVDESC=$(PLCNAME) Steriliser) ILKs")
  field(FTVL, "SHORT")
  field(INP, "$(PLCNAME):READ:WPUV.VAL")
  field(MALM, "18")
  field(NELM, "3")
  field(INDX, "15")
}

# WPUV: End of records containing raw state and interlock values.
# -------------------------------------------------------------
# WPUV: Records to provide meaningful state strings for the Water Turbine pump and the UV Steriliser .
# The Water Turbine pump State.
#
# % archiver 10 Monitor
#
record(mbbi, "$(WPNAME=$(PLCNAME):TRBNP):STATE:RBV") {
  field(DESC, "Water turbine pump State")
  field(ZRST, "On")
  field(ONST, "Off")
  field(TWST, "Reset")
  field(INP, "$(PLCNAME):TRBNP:SRAW:RBV MS")
}

# The Water Turbine pump overall interlock status.
# The ST and SV fields have been cribbed from the vacuumValve template.
#
# % archiver 10 Monitor
#
record(mbbi, "$(WPNAME=$(PLCNAME):TRBNP):ILKSTA:RBV") {
  field(DESC, "Water turbine pump ILK status")
  field(ZRST, "Failed")
  field(ONST, "Run Ilks OK")
  field(TWST, "OK")
  field(ZRSV, "MAJOR")
  field(ONSV, "NO_ALARM")
  field(TWSV, "NO_ALARM")
  field(INP, "$(PLCNAME):TRBNP:ILKSTARAW:RBV MS")
}

# The UV Steriliser State.
#
# % archiver 10 Monitor
#
record(mbbi, "$(UVNAME=$(PLCNAME):UVSTL):STATE:RBV") {
  field(DESC, "UV Steriliser State")
  field(ZRST, "On")
  field(ONST, "Off")
  field(TWST, "Reset")
  field(INP, "$(PLCNAME):UVSTL:SRAW:RBV MS")
}

# The UV Steriliser overall interlock status.
