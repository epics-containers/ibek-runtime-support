  field(DESC, "Propagate temperatures")
  field(LNK1, "$(PLCNAME):T1:TRAW:RBV")
  field(LNK2, "$(PLCNAME):T2:TRAW:RBV")
  field(LNK3, "$(PLCNAME):T3:TRAW:RBV")
  field(LNK4, "$(PLCNAME):T4:TRAW:RBV")
  field(LNK5, "$(PLCNAME):T5:TRAW:RBV")
  field(LNK6, "$(PLCNAME):T6:TRAW:RBV")
}

