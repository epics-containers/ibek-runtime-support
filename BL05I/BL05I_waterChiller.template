#****************************************************************
# PID: START OF RECORDS TO READ, WRITE AND PROCESS PID STATE.
# -------------------------------------------------------------
# PID:  Records to read the PID state data block.
# This gives the state of each PID loop, whether active or not, enabled or disabled.
# Please note the PID loop parameters for each valve are read and set as part of the
# valve data block above.
#
# This follows the model of being set up like a valve control as far as the
# records are concerned.
# These contain the values for both Valve PIDs.  They will be split off in
# single value subarrays.
record(waveform, "$(PLCNAME):READ:PID") {
  field(DESC, "Valve PID States 0030-0049")
  field(DTYP, "stream")
  field(SCAN, "Passive")
  field(INP, "@Hostlink.proto readDMmulti(0030) $(port)")
  field(NELM, "20")
  field(FTVL, "SHORT")
  field(FLNK, "$(PLCNAME):FAN:PID.PROC PP")
}

