#
# % archiver 10 Monitor
#
record(mbbi, "$(UVNAME=$(PLCNAME):UVSTL):ILKSTA:RBV") {
  field(DESC, "UV Steriliser interlock status")
  field(ZRST, "Failed")
  field(ONST, "Run Ilks OK")
  field(TWST, "OK")
  field(ZRSV, "MAJOR")
  field(ONSV, "NO_ALARM")
  field(TWSV, "NO_ALARM")
  field(INP, "$(PLCNAME):UVSTL:ILKSTARAW:RBV MS")
}

# WPUV: End of records to provide meaningful state strings for the Water Turbine pump and the UV Steriliser.
