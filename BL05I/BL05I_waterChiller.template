# PFT: START OF RECORDS TO READ, WRITE AND PROCESS PRESSURE, FLOW AND TEMPERATURE DATA
# -------------------------------------------------------------
# PFT: Records to read the pressure, flow and temperature sensor data block.
# These are all "Read-only" values.
# Read 16 current values from the DM memory from the PLC control crate.
# These contain the readbacks pressures, flows and temperatures.
# They will be split off into single value subarrays.
record(waveform, "$(PLCNAME):READ:PFT") {
  field(DESC, "Press, flow, temp, 0210-0219")
  field(DTYP, "stream")
  field(SCAN, "Passive")
  field(INP, "@Hostlink.proto readDMmulti(0210) $(port)")
  field(NELM, "10")
  field(FTVL, "SHORT")
  field(FLNK, "$(PLCNAME):FAN:PFT.PROC PP")
}

