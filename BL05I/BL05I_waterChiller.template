# PFT: Records to process the PFT data blocks.
# Fanout the processing for the raw Pressure, Flow and Temperature records.
record(fanout, "$(PLCNAME):FAN:PFT") {
  field(DESC, "Propagate press, flow, temp")
  field(LNK1, "$(PLCNAME):P1:PRAW:RBV")
  field(LNK2, "$(PLCNAME):P2:PRAW:RBV")
  field(LNK3, "$(PLCNAME):F1:FRAW:RBV")
  field(LNK4, "$(PLCNAME):F2:FRAW:RBV")
  field(FLNK, "$(PLCNAME):FAN:TEMPS.PROC")
}

# Fanout the processing to all the raw temperature records.
