# -------------------------------------------------------------
# PFT: Start of calculation records.
# Possible suggestions for more stats here:
# Current Mintemp.??
# Cumulative Max and min temp and timestamp. - need ability to reset accumulation.
# Not sure if this should be on an individual sensor or the combined one.
# Stats for pressure, and flow also.
# Record to pick the maximum temperature reading present in the system.
record(transform, "$(PLCNAME):TFM:MAXTEMP") {
  field(DESC, "Select max temp reading.")
  field(SCAN, "Passive")
  field(INPA, "$(T1NAME=$(PLCNAME):T1):TEMP:RBV")
  field(INPB, "$(PLCNAME):T1:ISPRESENT")
  field(INPC, "$(T2NAME=$(PLCNAME):T2):TEMP:RBV")
  field(INPD, "$(PLCNAME):T2:ISPRESENT")
  field(INPE, "$(T3NAME=$(PLCNAME):T3):TEMP:RBV")
  field(INPF, "$(PLCNAME):T3:ISPRESENT")
  field(INPG, "$(T4NAME=$(PLCNAME):T4):TEMP:RBV")
  field(INPH, "$(PLCNAME):T4:ISPRESENT")
  field(INPI, "$(T5NAME=$(PLCNAME):T5):TEMP:RBV")
  field(INPJ, "$(PLCNAME):T5:ISPRESENT")
  field(INPK, "$(T6NAME=$(PLCNAME):T6):TEMP:RBV")
  field(INPL, "$(PLCNAME):T6:ISPRESENT")
#  The desired formula was too long to fit in a single EPICS string field, therefore had to
#  convert from calc to transform record to use multiple fields.
#  field(CALC, "MAX(A*(A&&B),C*(C&&D),E*(E&&F),G*(G&&H),I*(I&&J),K*(K&&L))")
  field(CLCM, "MAX(A*(A&&B),C*(C&&D),E*(E&&F))")
  field(CLCN, "MAX(G*(G&&H),I*(I&&J),K*(K&&L))")
  field(CLCO, "MAX(M,N)")
  field(OUTO, "$(PLCNAME):PFT:MAXTEMP PP")
}

# This record has not picked up the severities.
record(ai, "$(PLCNAME):PFT:MAXTEMP") {
  field(DESC, "Current high temp reading.")
  field(SCAN, "Passive")
  field(PINI, "YES")
  field(VAL, "0")
  field(FLNK, "$(PLCNAME):CLC:MAXTS PP")
}

# Combine the temperature severities of the temperature sensors present in the system.
# You cannot put to the severity field of a record, so cannot use this to set the
# severity on the MAXTEMP above.
record(transform, "$(PLCNAME):TFM:TEMPSEVR") {
  field(DESC, "Calculate combined temperature severity.")
  field(SCAN, "Passive")
  field(INPA, "$(T1NAME=$(PLCNAME):T1):TEMP:RBV.SEVR")
  field(INPB, "$(PLCNAME):T1:ISPRESENT")
  field(INPC, "$(T2NAME=$(PLCNAME):T2):TEMP:RBV.SEVR")
  field(INPD, "$(PLCNAME):T2:ISPRESENT")
  field(INPE, "$(T3NAME=$(PLCNAME):T3):TEMP:RBV.SEVR")
  field(INPF, "$(PLCNAME):T3:ISPRESENT")
  field(INPG, "$(T4NAME=$(PLCNAME):T4):TEMP:RBV.SEVR")
  field(INPH, "$(PLCNAME):T4:ISPRESENT")
  field(INPI, "$(T5NAME=$(PLCNAME):T5):TEMP:RBV.SEVR")
  field(INPJ, "$(PLCNAME):T5:ISPRESENT")
  field(INPK, "$(T6NAME=$(PLCNAME):T6):TEMP:RBV.SEVR")
  field(INPL, "$(PLCNAME):T6:ISPRESENT")
  field(CLCM, "MAX(A*(A&&B),C*(C&&D),E*(E&&F))")
  field(CLCN, "MAX(G*(G&&H),I*(I&&J),K*(K&&L))")
  field(CLCO, "MAX(M,N)")
  field(OUTO, "$(PLCNAME):PFT:TEMPSEVR.VAL PP")
}

# The device temperature severity.  Not clear how to make EDM pick this up elegantly.
#record(ai, "$(P)$(R):TEMPSEVR") {
