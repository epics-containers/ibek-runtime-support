# -------------------------------------------------------------
# PID: Records to process the PID state data block.
# Fanout the processing for the raw Water Pump records and Bug killer.
record(fanout, "$(PLCNAME):FAN:PID") {
  field(DESC, "Propagate PID Enable status")
  field(LNK1, "$(PLCNAME):V1:PID:SRAW:RBV")
  field(LNK2, "$(PLCNAME):V2:PID:SRAW:RBV")
}

