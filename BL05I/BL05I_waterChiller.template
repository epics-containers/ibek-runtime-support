record(waveform, "$(PLCNAME):READ:PFTHIHI") {
  field(DESC, "Press, flow, temp, 0110-0119")
  field(DTYP, "stream")
  field(SCAN, "Passive")
  field(INP, "@Hostlink.proto readDMmulti(0110) $(port)")
  field(NELM, "10")
  field(FTVL, "SHORT")
  field(FLNK, "$(PLCNAME):FAN:PFTHIHI.PROC PP")
}

# PFT: End of records to read the pressure, flow and temperature sensor data block.
