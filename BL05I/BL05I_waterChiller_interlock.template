# File WaterChillerInterlock.template
#
# Since we have the Water Pump and the UV Steriliser both needing similar interlock records, put this into a template to avoid duplicating code.
# These records are very similar to those defined in the vacuumValve template, but we cannot reuse that.

# % macro, __doc__, 	Template 	Shows the status of various MPS interlocks for a device in the Water Chiller PLC.
# Substitutions:
# % macro, device,	Mandatory	Device record prefix of the subcomponent of the Water Chiller System.  Used to build record names.
# % macro, DDESC,	Mandatory	Sub Device description. Keep shortish because the template adds to the string on different records.

# This associates an edm screen with the template
# % gui, $(name=), edm, WaterChillerInterlock.edl, device=$(device)

# Terminology of interlock, initial and raw cribbed from vacuum templates.

# The single element slice of the Interlock trio data waveform representing device interlock value (latched?).
# This is a single value of 16 bits containing all the potential interlock levels.
record(subArray, "$(device):LRAW") {
  field(DESC, "Raw $(DDESC) Latched ILK")
  field(FTVL, "SHORT")
  field(INP, "$(device):ILKS:RBV.VAL CP MS")
  field(MALM, "3")
  field(NELM, "1")
  field(INDX, "0")
  field(FLNK, "$(device):ILK PP")
}

# The single element slice of the Interlock trio data waveform representing device initial interlock value.
# This is a single value of 16 bits containing all the potential interlock levels.
record(subArray, "$(device):IRAW") {
  field(DESC, "Raw $(DDESC) Initial ILK")
  field(FTVL, "SHORT")
  field(INP, "$(device):ILKS:RBV.VAL CP MS")
  field(MALM, "3")
  field(NELM, "1")
  field(INDX, "1")
  field(FLNK, "$(device):INIILK PP")
}

# The single element slice of the Interlock trio data waveform representing device raw/current interlock value.
# This is a single value of 16 bits containing all the potential interlock levels.
record(subArray, "$(device):RRAW") {
  field(DESC, "Raw $(DDESC) Raw ILK")
  field(FTVL, "SHORT")
  field(INP, "$(device):ILKS:RBV.VAL CP MS")
  field(MALM, "3")
  field(NELM, "1")
  field(INDX, "2")
  field(FLNK, "$(device):RAWILK PP")
}

# Records to convert from numeric to meaningful strings.

# % archiver 10 Monitor
record(mbbiDirect, "$(device):ILK") {
  field(DESC, "$(DDESC) Latched ILKs")
  field(INP, "$(device):LRAW MS")
}

# % archiver 10 Monitor
record(mbbiDirect, "$(device):INIILK") {
  field(DESC, "$(DDESC) Initial ILKs")
  field(INP, "$(device):IRAW MS")
}

# % archiver 10 Monitor
record(mbbiDirect, "$(device):RAWILK") {
  field(DESC, "$(DDESC) Initial ILKs")
  field(INP, "$(device):RRAW MS")
}

# Individual interlock bit definitions.
# These adapted from vacuum valve template.  The states are extracted from the Latched interlock records.
# The ONAM and ZNAM are the same because they are used to label all the interlocks in the interlocks screen.
# The strings have to allow for either state therefore.
record(bi, "$(device):ILK0") {
  field(DESC, "$(DDESC) Interlock 0")
  field(INP, "$(device):ILK.B0 CP MS")
  field(ZSV, "MAJOR")
  field(OSV, "NO_ALARM")
  field(ZNAM, "$(ilk0=unused)")
  field(ONAM, "$(ilk0=unused)")
}

