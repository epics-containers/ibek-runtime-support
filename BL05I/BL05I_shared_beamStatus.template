# Template for BL05I mainline to support the beam status widgets on the shared part of the synoptic.
# 
# Absorbers, shutters and diagnostic screens are usually included in the beam status calculations, but vacuum valve status is ignored
# (believe this is because the interlock system normally stops the beam hitting valves anyway).
# This template includes the status of the manual valves (readback) which are present on this low-energy beamline.
# The beamline has control over ABSB0 (sometimes). However there is no info for us to know, so have to assume it is there.
# This record calculates things up to the shutter at the entrance of each end station.
# 
# % macro, P, Device PV Prefix
# % macro, P1, Device PV Prefix for I-branch line propagation
# % macro, P2, Device PV Prefix for J-branch line propagation
record(calc, "$(P):TOABSB0:STA") {
  field(CALC, "1")
  field(SCAN, "5 second")
  field(FLNK, "$(P):ABSB0TOSHTR0:STA.PROC")
}

# ABSB0, which the beamline can control is actually ABSB1 in the Front End. It is followed by a Front End SHTR1, which it cannot
# control and then  another shutter (SHTR0) which it controls indirectly, Front End SHTR2.  Therefore calculate stuff upto SHTR0 in this record.
record(calc, "$(P):ABSB0TOSHTR0:STA") {
  field(CALC, "A=1&B=1&C=1")
  field(INPA, "$(P):TOABSB0:STA.VAL NPP MS")
  field(INPB, "FE05I-RS-ABSB-01:STA CP MS")
  field(INPC, "FE05I-PS-SHTR-01:STA CP MS")
  field(FLNK, "$(P):SHTR0TOD1:STA.PROC")
}

# This is the first section in the actual beamline, immediately after SHTR0.  There is actually a valve (GV0) after the shutter, but
# we ignore valves in the beam calculation since they are indicated by the vacuum space widgets.
# D1 has been abolished, but leave the record names for now to avoid rebuilding the GUI.
record(calc, "$(P):SHTR0TOD1:STA") {
  field(CALC, "A=1&B=1")
  field(INPA, "$(P):ABSB0TOSHTR0:STA.VAL NPP MS")
  field(INPB, "FE05I-PS-SHTR-02:STA CP MS")
  field(FLNK, "$(P):D1TOD2:STA.PROC")
}

# The pneumatic valve status needs to be "Closed", meaning out of the beam,
# equivalent to value 3.
# D1 has been abolished, but leave the records for now to avoid too much hacking the GUI.
# Just change calculation to be same value as higher up the beamline.
record(calc, "$(P):D1TOD2:STA") {
#  field(CALC, "A=1&B=3")
  field(CALC, "A=1")
  field(INPA, "$(P):SHTR0TOD1:STA.VAL NPP MS")
#  field(INPB, "BL05I-DI-PHDGN-01:STA NPP MS")
  field(FLNK, "$(P):D2TOD3:STA.PROC")
}

# The pneumatic valve status needs to be "Closed", meaning out of the beam,
# equivalent to value 3.
record(calc, "$(P):D2TOD3:STA") {
  field(CALC, "A=1&B=3")
  field(INPA, "$(P):D1TOD2:STA.VAL NPP MS")
  field(INPB, "BL05I-DI-PHDGN-02:STA")
  field(FLNK, "$(P):D3TOM3MJ6:STA")
}

record(calc, "$(P):D3TOM3MJ6:STA") {
  field(CALC, "A=1&B=3")
  field(INPA, "$(P):D2TOD3:STA.VAL NPP MS")
  field(INPB, "BL05I-DI-PHDGN-03:STA MS")
  field(FLNK, "$(P):M3MJ6TOCROTCH:STA")
}

record(calc, "$(P):M3MJ6TOCROTCH:STA") {
  field(CALC, "A=1")
  field(INPA, "$(P):D3TOM3MJ6:STA.VAL NPP MS")
  field(FLNK, "$(P):CROTCH:STA")
}

# Put extra records here for convenience because this is where 
# things split for the branch into separate databases.
record(calc, "$(P):CROTCH:STA") {
  field(CALC, "A=1")
  field(INPA, "$(P):M3MJ6TOCROTCH:STA.VAL NPP MS")
  field(FLNK, "$(P):BRANCH_RBV")
}

# Checking which branch line is currently in use from M3Mj6 switching mirror position (0=unknown, 1=MJ6, 2=M3).
# Note the CALC field required to enable the correct link to be processed as fanout links are not zero-based.
record(calc, "$(P):BRANCH_RBV") {
  field(DESC, "Current beamline branch")
  field(SCAN, "Passive")
  field(CALC, "A+1")
  field(INPA, "BL05I-OP-SWTCH-01:MIRCTRL:GET:MIRROR")
  field(FLNK, "$(P):BRANCH")
}

# If M3MJ6 position is unknown, fanout is needed to propagate the processing chain to records for both
# branches (i.e. beam on both branches marked as ON for safety measures).
# The records belong to BL05I-VA-IOC-02 and BL05J-VA-IOC-01 respectively.
record(fanout, "$(P):BRANCH_ALL") {
  field(LNK1, "$(P1):CROTCH:STA.PROC")
  field(LNK2, "$(P2):CROTCH:STA.PROC")
}

record(fanout, "$(P):BRANCH") {
  field(SELM, "Specified")
  field(SELL, "$(P):BRANCH_RBV")
  field(LNK1, "$(P):BRANCH_ALL")
  field(LNK2, "$(P2):CROTCH:STA.PROC")
  field(LNK3, "$(P1):CROTCH:STA.PROC")
  field(DESC, "Select branch triggering")
}

